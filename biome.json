{
  "$schema": "node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "apps/**",
      "packages/**",
      "scripts/**",
      ".pi/**",
      "!.pi/generated-skills",
      "!**/temp/*",
      "!**/tmp/*",
      "!**/dist/*",
      "!**/build/*",
      "!apps/frontend/client/static",
      "!**/*.svelte.ts",
      "!**/src/lib/paraglide/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100,
    "attributePosition": "auto",
    "bracketSpacing": true,
    "useEditorconfig": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noThenProperty": "error",
        "noExplicitAny": "error",
        "noConsole": "error",
        "noShadow": "error",
        "noNestedPromises": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "noNestedTernary": "error",
        "useCollapsedIf": "error",
        "useCollapsedElseIf": "error",
        "useConsistentArrowReturn": "error",
        "useThrowOnlyError": "error",
        "useConsistentObjectDefinitions": {
          "level": "error",
          "options": {
            "syntax": "shorthand"
          }
        },
        "useImportType": "error",
        "useNodejsImportProtocol": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["snake_case"]
          }
        },
        "useNumberNamespace": "error",
        "noSubstr": "error",
        "useBlockStatements": "error",
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false,
            "conventions": [
              {
                "selector": { "kind": "classMember", "modifiers": ["private"] },
                "match": "_(.+)",
                "formats": ["camelCase"]
              }
            ]
          }
        },
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "type"
          }
        },
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@sinclair/typebox": "Define schemas in packages/shared/schemas/ and import from @aikami/schemas",
              "zod": "Define schemas in packages/shared/schemas/ and import from @aikami/schemas"
            },
            "patterns": [
              {
                "group": [
                  "@aikami/backend-*",
                  "@aikami/backend-*/**",
                  "!@aikami/backend-project-ai",
                  "!@aikami/backend-project-ai/**",
                  "!@aikami/backend-database",
                  "!@aikami/backend-database/**",
                  "!@aikami/backend-discord-bot",
                  "!@aikami/backend-discord-bot/**"
                ],
                "message": "Use @aikami/backend/<name> instead (e.g. @aikami/backend/auth)"
              },
              {
                "group": [
                  "@aikami/frontend-*",
                  "@aikami/frontend-*/**",
                  "!@aikami/frontend-preview",
                  "!@aikami/frontend-preview/**"
                ],
                "message": "Use @aikami/frontend/<name> instead (e.g. @aikami/frontend/configs)"
              }
            ]
          }
        }
      },
      "complexity": {
        "useArrowFunction": "error",
        "noUselessSwitchCase": "error",
        "useFlatMap": "error",
        "useDateNow": "error",
        "noForEach": "error",
        "noStaticOnlyClass": "error",
        "noBannedTypes": "error"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "useImportExtensions": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "bracketSameLine": false,
      "attributePosition": "auto",
      "operatorLinebreak": "after"
    },
    "globals": ["Bun", "process", "fetch", "prompt"]
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "enabled": true,
      "indentScriptAndStyle": false
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["**/*.d.ts"],
      "linter": {
        "rules": {
          "style": {
            "useConsistentTypeDefinitions": "off",
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/e2e/**", "scripts/**", ".pi/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off",
            "noExplicitAny": "off"
          },
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/backend/**",
        "apps/backend/**",
        "apps/frontend/hub/src/lib/server/**",
        "!**/*.test.ts",
        "!**/tests/**",
        "!**/__tests__/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "window": "Server-plane code has no DOM. Pass values in explicitly.",
                  "document": "Server-plane code has no DOM.",
                  "localStorage": "Server-plane code has no DOM — use D1/R2 via the repository layer.",
                  "sessionStorage": "Server-plane code has no DOM.",
                  "navigator": "Server-plane code has no DOM.",
                  "alert": "Server-plane code has no DOM."
                }
              }
            },
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@sinclair/typebox": "Define schemas in packages/shared/schemas/ and import from @aikami/schemas",
                  "zod": "Define schemas in packages/shared/schemas/ and import from @aikami/schemas"
                },
                "patterns": [
                  {
                    "group": [
                      "svelte",
                      "svelte/**",
                      "@sveltejs/kit/**",
                      "$lib/views/**",
                      "$views/**",
                      "@aikami/frontend/**",
                      "@aikami/frontend-*"
                    ],
                    "message": "Server-plane code must not import frontend modules."
                  },
                  {
                    "group": [
                      "@aikami/backend-*",
                      "@aikami/backend-*/**",
                      "!@aikami/backend-project-ai",
                      "!@aikami/backend-project-ai/**",
                      "!@aikami/backend-database",
                      "!@aikami/backend-database/**",
                      "!@aikami/backend-discord-bot",
                      "!@aikami/backend-discord-bot/**"
                    ],
                    "message": "Use @aikami/backend/<name> instead (e.g. @aikami/backend/auth)"
                  },
                  {
                    "group": [
                      "@aikami/frontend-*",
                      "@aikami/frontend-*/**",
                      "!@aikami/frontend-preview",
                      "!@aikami/frontend-preview/**"
                    ],
                    "message": "Use @aikami/frontend/<name> instead (e.g. @aikami/frontend/configs)"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/frontend/**",
        "apps/frontend/client/src/**",
        "!**/*.test.ts",
        "!**/*.spec.ts",
        "!**/tests/**",
        "!**/__tests__/**",
        "!**/test_preload.ts",
        "!**/*_node.ts",
        "!**/src/node.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Bun": "Frontend runs in a browser/Tauri webview — there is no Bun runtime.",
                  "process": "Frontend has no `process` — use import.meta.env or a Tauri command."
                }
              }
            },
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@sinclair/typebox": "Define schemas in packages/shared/schemas/ and import from @aikami/schemas",
                  "zod": "Define schemas in packages/shared/schemas/ and import from @aikami/schemas"
                },
                "patterns": [
                  {
                    "group": ["node:*", "node:*/**"],
                    "message": "Frontend runs in a browser/Tauri webview — no Node builtins. Use a Tauri command or a Web API."
                  },
                  {
                    "group": ["@aikami/backend/**", "@aikami/backend-*"],
                    "message": "Frontend must not import backend packages — cross the boundary via HTTP or a repository."
                  },
                  {
                    "group": [
                      "@aikami/backend-*",
                      "@aikami/backend-*/**",
                      "!@aikami/backend-project-ai",
                      "!@aikami/backend-project-ai/**",
                      "!@aikami/backend-database",
                      "!@aikami/backend-database/**",
                      "!@aikami/backend-discord-bot",
                      "!@aikami/backend-discord-bot/**"
                    ],
                    "message": "Use @aikami/backend/<name> instead (e.g. @aikami/backend/auth)"
                  },
                  {
                    "group": [
                      "@aikami/frontend-*",
                      "@aikami/frontend-*/**",
                      "!@aikami/frontend-preview",
                      "!@aikami/frontend-preview/**"
                    ],
                    "message": "Use @aikami/frontend/<name> instead (e.g. @aikami/frontend/configs)"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/*.svelte"],
      "linter": { "rules": { "style": { "noRestrictedGlobals": "off" } } }
    }
  ]
}
