{
  "$schema": "node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "master"
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "apps/**",
      "packages/**",
      "scripts/**",
      ".pi/**",
      "!.pi/generated-skills",
      "!**/temp/*",
      "!**/tmp/*",
      "!**/dist/*",
      "!**/build/*",
      "!apps/frontend/client/static/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100,
    "attributePosition": "auto",
    "bracketSpacing": true,
    "useEditorconfig": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noThenProperty": "error",
        "noExplicitAny": "error",
        "noConsole": "error",
        "noShadow": "error",
        "noNestedPromises": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "noNestedTernary": "error",
        "useCollapsedIf": "error",
        "useCollapsedElseIf": "error",
        "useConsistentArrowReturn": "error",
        "useThrowOnlyError": "error",
        "useConsistentObjectDefinitions": {
          "level": "error",
          "options": {
            "syntax": "shorthand"
          }
        },
        "useImportType": "error",
        "useNodejsImportProtocol": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["snake_case"]
          }
        },
        "useNumberNamespace": "error",
        "noSubstr": "error",
        "useBlockStatements": "error",
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false,
            "conventions": [
              {
                "selector": { "kind": "classMember", "modifiers": ["private"] },
                "match": "_(.+)",
                "formats": ["camelCase"]
              }
            ]
          }
        },
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "type"
          }
        },
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@sinclair/typebox": "Define schemas in packages/shared/schemas/ and import from @aikami/schemas",
              "zod": "Define schemas in packages/shared/schemas/ and import from @aikami/schemas"
            },
            "patterns": [
              {
                "group": [
                  "@aikami/backend-*",
                  "!@aikami/backend-project-ai",
                  "!@aikami/backend-database",
                  "!@aikami/backend-discord-bot"
                ],
                "message": "Use @aikami/backend/<name> instead (e.g. @aikami/backend/auth)"
              },
              {
                "group": [
                  "@aikami/frontend-*",
                  "!@aikami/frontend-preview"
                ],
                "message": "Use @aikami/frontend/<name> instead (e.g. @aikami/frontend/configs)"
              }
            ]
          }
        }
      },
      "complexity": {
        "useArrowFunction": "error",
        "noUselessSwitchCase": "error",
        "useFlatMap": "error",
        "useDateNow": "error",
        "noForEach": "error",
        "noStaticOnlyClass": "error",
        "noBannedTypes": "error"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "useImportExtensions": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "bracketSameLine": false,
      "attributePosition": "auto",
      "operatorLinebreak": "after"
    },
    "globals": ["Bun", "process", "fetch", "prompt"]
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "enabled": true,
      "indentScriptAndStyle": false
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["**/*.d.ts"],
      "linter": {
        "rules": {
          "style": {
            "useConsistentTypeDefinitions": "off",
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/e2e/**", "scripts/**", ".pi/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off",
            "noExplicitAny": "off"
          },
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    }
  ]
}
