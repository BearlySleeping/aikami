{
  "name": "@aikami/scripts",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "typecheck": "tsgo --noEmit",
    "lint": "biome check .",
    "format": "biome format .",
    "fix": "biome check --write . --error-on-warnings",
    "test": "bun test",
    "test:automation-unit": "bun test src/lib/agents/contract_pipeline src/lib/agents/evaluation src/lib/herdr/session.test.ts src/lib/env src/lib/ops/guard_service_mock_coverage.test.ts src/lib/ops/__tests__/guard_view_model_composition.test.ts src/lib/ops/__tests__/guard_mvvm_conventions.test.ts",
    "lint-contracts": "bun run src/lib/ops/lint_contracts.ts",
    "mark-implemented": "bun run src/lib/ops/mark_contract_implemented.ts"
  },
  "dependencies": {
    "@aikami/constants": "workspace:*",
    "@aikami/schemas": "workspace:*",
    "@aikami/types": "workspace:*",
    "@discordjs/rest": "2.6.3",
    "discord-api-types": "0.38.55"
  },
  "devDependencies": {
    "cf": "0.9.1",
    "jiti": "2.7.0",
    "png-to-ico": "3.0.2",
    "sharp": "0.35.4",
    "typescript": "6.0.3",
    "wrangler": "4.130.0"
  }
}
