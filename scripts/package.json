{
  "name": "@aikami/scripts",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "typecheck": "tsgo --noEmit",
    "lint": "biome check .",
    "format": "biome format .",
    "fix": "biome check --write . --error-on-warnings",
    "test": "bun test",
    "lint-contracts": "bun run src/lib/ops/lint_contracts.ts",
    "mark-implemented": "bun run src/lib/ops/mark_contract_implemented.ts"
  },
  "dependencies": {
    "@aikami/constants": "workspace:*",
    "@aikami/schemas": "workspace:*",
    "@aikami/types": "workspace:*",
    "@discordjs/rest": "2.6.3",
    "discord-api-types": "0.38.54"
  },
  "devDependencies": {
    "cf": "0.8.0",
    "png-to-ico": "3.0.2",
    "sharp": "0.35.4",
    "wrangler": "4.127.1"
  }
}
