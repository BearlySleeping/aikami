# scripts/.env.example
#
# Secrets required by the deploy pipeline (scripts/src/lib/deploy/*).
# Only keys listed here are fetched from GCP Secret Manager by
# scripts/src/lib/ops/download_secrets.ts (--strict fails if any can't be
# fetched, so every key here must exist in GSM for staging + production).
#
# NOTE: TELEGRAM_* and VLM_* were removed — TELEGRAM_* is only used by the
# optional --notify flag (never passed in CI) and VLM_* belongs to the pi
# extension's own environment (code defaults, not the deploy pipeline).
REDIS_URL=
REDIS_TOKEN=
OPENROUTER_API_KEY=

# Tauri updater artifact signing (client-tauri desktop builds). Must exist in
# BOTH aikami-staging and aikami-production with the SAME value — there is
# only one updater pubkey (src-tauri/tauri.conf.json plugins.updater.pubkey),
# so both channels are verified by the same keypair. Not GitHub Actions
# secrets: ci_run.ts's initScriptsEnv(mode) loads this file into process.env
# before spawning `tauri build`, which reads these directly as OS env vars.
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Discord release announcements (discord_notify.ts). Optional — the script
# no-ops if this is blank, so it's safe to leave unset in staging. Points at
# #releases in production, #releases-staging in staging — a DIFFERENT
# webhook per mode (each channel has its own webhook URL), not one URL
# reused across modes.
DISCORD_RELEASES_WEBHOOK_URL=

# Discord deploy-failure notifications (discord_notify.ts --failure, see
# release.yml's notify-failure job). Optional — the script no-ops if this is
# blank. A SEPARATE webhook from DISCORD_RELEASES_WEBHOOK_URL above, pointed
# at the staff-only #staff channel — a deploy failure is internal ops noise,
# not something the public #releases channel should see.
DISCORD_STAFF_WEBHOOK_URL=

# Discord dev-activity notifications (discord_dev_notify.ts, GH Actions only
# — see .github/workflows/discord_dev_notify.yml). A SEPARATE webhook from
# DISCORD_RELEASES_WEBHOOK_URL above, pointed at #github-feed (a much
# higher-volume channel): create it the same way (channel Settings →
# Integrations → Webhooks → New Webhook) and set it as a GitHub Actions
# repo secret of the same name — this script never reads it from
# scripts/.env.{mode}, only from the environment GH Actions provides.
DISCORD_GITHUB_FEED_WEBHOOK_URL=

# Discord server management (scripts/src/lib/discord/) + the Interactions
# Endpoint (/bug /feature /ask — apps/backend/firebase/src/controllers/api/
# discord_interactions.ts). A webhook can only post messages — managing
# channels/roles and handling slash commands needs a real bot identity:
#   1. https://discord.com/developers/applications → New Application.
#   2. Bot tab → Reset Token → copy it into DISCORD_BOT_TOKEN below.
#   3. General Information tab → copy "Application ID" → DISCORD_APP_ID,
#      and "Public Key" → DISCORD_PUBLIC_KEY (goes in the FIREBASE app's
#      env, not here — see apps/backend/firebase/.env.example).
#   4. OAuth2 → URL Generator → scopes "bot" + "applications.commands" →
#      permissions "Manage Channels" + "Manage Roles" → open the generated
#      URL and invite it to the server.
#   5. In Discord, enable Developer Mode (User Settings → Advanced), then
#      right-click the server icon → "Copy Server ID" → DISCORD_GUILD_ID.
#   6. Once discord_interactions.ts is deployed, paste its URL into
#      General Information → "Interactions Endpoint URL", then run
#      `bun run discord:commands:sync` to register /bug /feature /ask.
# The bot's own role must sit ABOVE any role it needs to create/edit
# (Discord role hierarchy — a bot can never manage a role ranked above it).
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=1326946946136408064
DISCORD_APP_ID=

# Cloudflare R2 — catalog asset origin (C-395, ADR D-13).
# S3-compatible WRITE credentials for the catalog publish pipeline
# (scripts/src/lib/catalog/). These belong to the pipeline, NOT to the hub:
# the hub never writes to R2 (invariant I-7), so they must never appear in
# apps/frontend/hub/.env.* where buildSecretArgsFromEnvFile would ship them
# to Cloud Run.
#
# ACCESS_KEY_ID + SECRET_ACCESS_KEY + ENDPOINT are all the S3 client needs.
# TOKEN is the Cloudflare REST API token (bucket administration), not used
# for S3 object operations — keep it only if a management task needs it.
#
# Each R2 plane has its own bucket-scoped credential set: CATALOG (public
# asset origin), DIST (model weights / distribution), UPLOADS (private
# member-intake, hub presigns only). See docs/architecture/object-storage-layout.md.
CLOUD_FLARE_CATALOG_BUCKET_TOKEN=
CLOUD_FLARE_CATALOG_BUCKET_ACCESS_KEY_ID=
CLOUD_FLARE_CATALOG_BUCKET_SECRET_ACCESS_KEY=
CLOUD_FLARE_CATALOG_BUCKET_ENDPOINT=

# Catalog publish — injected configuration, never hardcoded (C-395 Open
# Question 1: no hostname in code or fixtures). CATALOG_ORIGIN_URL is the
# public origin base that the catalog index records; CATALOG_BUCKET defaults
# to aikami-catalog.
CATALOG_BUCKET=aikami-catalog
CATALOG_ORIGIN_URL=https://assets.bearlysleeping.com

# Cloudflare R2 — distribution plane (aikami-dist, dl.bearlysleeping.com).
# Bucket-scoped WRITE credentials for the mirror job that populates model
# weights / release artifacts. Used by scripts/src/lib/dist/ (C-…).
CLOUD_FLARE_DIST_BUCKET_TOKEN=
CLOUD_FLARE_DIST_BUCKET_ACCESS_KEY_ID=
CLOUD_FLARE_DIST_BUCKET_SECRET_ACCESS_KEY=
CLOUD_FLARE_DIST_BUCKET_ENDPOINT=
CLOUD_FLARE_DIST_BUCKET=aikami-dist
# Public origin of the distribution plane (injected, never hardcoded).
DIST_ORIGIN_URL=https://dl.bearlysleeping.com

# Cloudflare R2 — intake plane (aikami-uploads, private).
# Bucket-scoped credential used only to mint presigned upload URLs for the
# hub (C-398); the hub never reads or proxies member bytes (I-7). Objects
# staged under staging/ expire after 14 days via lifecycle rule.
CLOUD_FLARE_UPLOADS_BUCKET_TOKEN=
CLOUD_FLARE_UPLOADS_BUCKET_ACCESS_KEY_ID=
CLOUD_FLARE_UPLOADS_BUCKET_SECRET_ACCESS_KEY=
CLOUD_FLARE_UPLOADS_BUCKET_ENDPOINT=
CLOUD_FLARE_UPLOADS_BUCKET=aikami-uploads
