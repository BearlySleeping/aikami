# apps/backend/worker/.env.example
#
# Union of every worker this VM hosts' required env keys — see
# src/index.ts. Locally, Bun auto-loads .env.{mode} (see src/env.ts), so
# `bun run start` needs one of these filled in. In production, none of
# these are set on the container directly (see README.md) — src/env.ts
# falls back to fetching them from Secret Manager via the VM's own
# identity, which only works ON the VM itself.

# @aikami/backend-discord-bot — Gateway bot (DISCORD_BOT_REQUIRED_ENV_KEYS)
DISCORD_BOT_TOKEN=
GITHUB_ISSUES_TOKEN=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# @aikami/backend-discord-bot — Interactions Endpoint (DISCORD_INTERACTIONS_REQUIRED_ENV_KEYS)
# OPENROUTER_API_KEY / OPENROUTER_MODEL above are shared with the Gateway bot.
DISCORD_PUBLIC_KEY=

# @aikami/backend-discord-bot — /notify relay (DISCORD_NOTIFY_REQUIRED_ENV_KEYS,
# TASK 4). Sensitive production credential for scripts/src/lib/discord/post.ts's
# HMAC — possessing it permits authenticated requests to the /notify relay. CI
# holds this secret, never DISCORD_BOT_TOKEN, and this process (which does hold
# the token) posts on its behalf so the message still appears as AiKami Bot.
# The same value must
# also exist in scripts/.env.{mode} (see scripts/.env.example) and as a
# GitHub Actions repo secret — see that file's comment for why it needs to
# live in all three places.
WORKER_NOTIFY_SECRET=

# NOTE: WORKER_TLS_CERT / WORKER_TLS_KEY (the Cloudflare Origin CA cert/key
# src/index.ts's resolveTls() reads — see README.md's "HTTP surface")
# are deliberately NOT listed here. They're multi-line PEM values; this
# repo's .env pipeline (download-secrets/upload-secrets) writes/reads
# single-line `KEY=value` — round-tripping a PEM through it would mangle
# the embedded newlines. They exist ONLY as Secret Manager secrets,
# fetched directly by src/secrets.ts's raw REST call (which preserves
# newlines exactly, unlike the .env text pipeline), and are irrelevant to
# local dev — resolveTls() falls back to plain HTTP when they're absent.
