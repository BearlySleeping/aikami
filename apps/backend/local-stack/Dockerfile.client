# apps/backend/local-stack/Dockerfile.client
# Lightweight client UI container.
#
# The SvelteKit SPA is built ON THE HOST and staged into .build/client:
#   cd apps/backend/local-stack && bun run build:client
# This image only packages the staged static output into nginx:alpine — no
# Node/Bun, no monorepo source in the image or build context.
#
# Runtime engine config (AC-9): the topology-specific config.json is NOT
# baked in. The compose `web` service mounts the emitted config at
# /usr/share/nginx/html/config.json, so one published image works against
# any engine hosts with zero rebuild.
#
# ── Build context ──────────────────────────────────────────────────────────
# This directory (`.`) — both `docker build` and `docker compose build`
# (docker or podman) send only the local-stack tree.

FROM nginx:1.27-alpine

# Prebuilt SPA output (staged locally via `bun run build:client`)
COPY .build/client /usr/share/nginx/html

# SPA-friendly nginx config (port 5274, index fallback, gzip, asset caching)
COPY docker/client/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 5274

# Drop privileges — nginx master runs as the dedicated non-root user. The
# official image's cache/pid paths are root-owned; make them writable and
# move the pid file to /tmp so `USER nginx` can actually start.
RUN mkdir -p /var/cache/nginx/client_temp /var/cache/nginx/proxy_temp \
        /var/cache/nginx/fastcgi_temp /var/cache/nginx/uwsgi_temp \
        /var/cache/nginx/scgi_temp \
    && chown -R nginx:nginx /var/cache/nginx \
    && sed -i 's|pid        /run/nginx.pid;|pid        /tmp/nginx.pid;|' /etc/nginx/nginx.conf \
    && touch /tmp/nginx.pid && chown nginx:nginx /tmp/nginx.pid

USER nginx

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s \
  CMD wget -q -O /dev/null http://127.0.0.1:5274/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
