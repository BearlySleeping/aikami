{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "lib": ["ESNext"],
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@aikami/constants": ["../../../packages/shared/constants/src/index.ts"],
      "@aikami/local-ai": ["../../../packages/shared/local-ai/src/index.ts"],
      "@aikami/lpc": ["../../../packages/shared/lpc/src/index.ts"],
      "@aikami/schemas": ["../../../packages/shared/schemas/src/index.ts"],
      "@aikami/types": ["../../../packages/shared/types/src/index.ts"],
      "$logger": ["../../../packages/shared/logger/src/index.ts"],
      "$logger/*": ["../../../packages/shared/logger/src/lib/*"]
    }
  },
  "include": ["stack/**/*.ts"]
}
