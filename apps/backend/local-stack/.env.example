# apps/backend/local-stack/.env.example
#
# The ONLY thing that varies in the local stack (C-390). Copy to `.env` and
# edit. Compose reads this file automatically — the runtime command is
# plain `docker compose up -d` with no flags.
#
# Copy:  cp .env.example .env

# ── Modality selection ────────────────────────────────────────────────────
# Which engines to start. Comma-separated subset of:
#   text   — llama.cpp server (OpenAI-compatible /v1) on port 11434
#   image  — stable-diffusion.cpp sd-server on port 8188
#   voice  — sherpa-onnx Kokoro TTS on port 8089
#   stt    — sherpa-onnx Moonshine STT on port 8087 (same voice container)
#   web    — opt-in web client container on port 5274
#   ollama / comfyui — advanced alternatives on the same ports (advanced)
# The model fetcher is profile-scoped: it downloads only the models for the
# modalities you enable.
COMPOSE_PROFILES=text,image,voice,stt

# ── Hardware backend ──────────────────────────────────────────────────────
# One of: cpu, cuda, rocm, vulkan, intel, musa.
# macOS/Metal: do NOT use a compose backend — run the native launchers
# (bin/run-native-*.sh); only `web` is containerised (README §macOS).
COMPOSE_FILE=compose.yaml:compose.cpu.yaml

# ── Model selection (paths inside the models volume) ──────────────────────
# Defaults match the manifest entries; TEXT_MODEL / IMAGE_MODEL select
# larger tiers from stack/models.manifest.json when you have the VRAM.
TEXT_MODEL=qwen2.5-1.5b-instruct-q4_k_m.gguf
IMAGE_MODEL=flux1-schnell-q4_k.gguf

# ── Licences ─────────────────────────────────────────────────────────────
# SD 1.5 is CreativeML OpenRAIL-M (use-restricted). Leave empty to skip it;
# the fetcher prints the licence and skips the download. Accept with the
# exact licence name from the manifest:
AIKAMI_ACCEPT_LICENSES=

# ── Ports (defaults from packages/shared/constants/development_ports.ts) ─
# Only override when the default is taken on your host.
# TEXT_PORT=11434
# IMAGE_PORT=8188
# TTS_PORT=8089
# STT_PORT=8087
# WEB_PORT=5274

# ── Voice extras ─────────────────────────────────────────────────────────
# Set true to also start the STT websocket server inside the voice container
# (required when you enable the `stt` profile).
ENABLE_STT=true

# ── Existing model trees (AC-13) ─────────────────────────────────────────
# Point at a pre-existing models/ directory from the old stack to bind-mount
# it instead of the named volume (nothing is moved or deleted):
# COMPOSE_FILE=compose.yaml:compose.models-path.yaml
# MODELS_PATH=/absolute/path/to/models

# ── Owned image registry (forks override this) ───────────────────────────
# AIKAMI_IMAGE_PREFIX=ghcr.io/aikami
