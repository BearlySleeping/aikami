rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ═══════════════════════════════════════════════════════════════
    // Helper Functions
    // ═══════════════════════════════════════════════════════════════

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.get('userRole', '') == 'superAdmin';
    }

    function isValidImageType() {
      return request.resource.contentType.matches('image/.*');
    }

    function isValidFileSize() {
      return request.resource.size <= 5 * 1024 * 1024; // 5MB
    }

    function isValidLPCImageType() {
      return request.resource.contentType in ['image/png', 'image/jpeg', 'image/jpg', 'image/webp'];
    }

    function isValidAudioType() {
      return request.resource.contentType.matches('audio/.*');
    }

    // ═══════════════════════════════════════════════════════════════
    // User avatars and uploads — owner only
    // ═══════════════════════════════════════════════════════════════
    match /users/{uid}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isOwner(uid) && isValidImageType() && isValidFileSize();
    }

    // ═══════════════════════════════════════════════════════════════
    // NPC avatars — public read, creator write
    // ═══════════════════════════════════════════════════════════════
    match /npcs/{npcId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isValidImageType() && isValidFileSize();
    }

    // ═══════════════════════════════════════════════════════════════
    // Game saves — owner-only, no file-type restrictions (JSON blobs)
    // ═══════════════════════════════════════════════════════════════
    match /saves/{uid}/{allPaths=**} {
      allow read, write: if isOwner(uid);
    }

    // ═══════════════════════════════════════════════════════════════
    // LPC character spritesheets — public read, admin-only write
    // ═══════════════════════════════════════════════════════════════
    match /lpc/{allPaths=**} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin() && isValidLPCImageType() && isValidFileSize();
    }

    // ═══════════════════════════════════════════════════════════════
    // Audio assets (music / sfx / ambient) — public read (C-373 AssetManager
    // fallback origin), admin-only write
    // ═══════════════════════════════════════════════════════════════
    match /music/{allPaths=**} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin() && isValidAudioType() && isValidFileSize();
    }
    match /sfx/{allPaths=**} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin() && isValidAudioType() && isValidFileSize();
    }
    match /ambient/{allPaths=**} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin() && isValidAudioType() && isValidFileSize();
    }

    // ═══════════════════════════════════════════════════════════════
    // Sprite / background image assets — public read (C-373 AssetManager
    // fallback origin), admin-only write
    // ═══════════════════════════════════════════════════════════════
    match /sprites/{allPaths=**} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin() && isValidImageType() && isValidFileSize();
    }
    match /backgrounds/{allPaths=**} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin() && isValidImageType() && isValidFileSize();
    }

    // ═══════════════════════════════════════════════════════════════
    // Online registry seed (manifest.json + asset_hashes.json) — public
    // read so clients can discover the available-asset catalog, admin-only
    // write
    // ═══════════════════════════════════════════════════════════════
    match /game-data/{allPaths=**} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    // Public assets — public read, authenticated write
    // ═══════════════════════════════════════════════════════════════
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isValidImageType() && isValidFileSize();
    }

    // ═══════════════════════════════════════════════════════════════
    // Tauri desktop releases — public read (download page), admin-only write
    // ═══════════════════════════════════════════════════════════════
    match /tauri-releases/{appName}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    // Default deny — explicit catch-all at the end
    // ═══════════════════════════════════════════════════════════════
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
