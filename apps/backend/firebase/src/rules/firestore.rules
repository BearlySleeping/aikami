rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ═══════════════════════════════════════════════════════════════
    // Firestore is fully vacated (C-386): chat, ChatLink, personas, NPCs,
    // custom agents, user profiles, and notifications now live in the
    // client's local SQLite database. No collection may be read or written.
    // ═══════════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
