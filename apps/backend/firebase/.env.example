# Backend
GEMINI_API_KEY=
FIREBASE_SERVICE_ACCOUNT=
APP_ID=firebase
MODE=emulator

REDIS_URL=
REDIS_TOKEN=

# Discord Interactions Endpoint (controllers/api/discord_interactions.ts —
# handles /bug, /feature, /ask). Get DISCORD_PUBLIC_KEY and DISCORD_APP_ID
# from the Discord Developer Portal, General Information tab (same app as
# scripts/.env.example's DISCORD_BOT_TOKEN). DISCORD_APP_ID isn't read at
# runtime by this app — kept here only as a reference alongside the key.
DISCORD_PUBLIC_KEY=
DISCORD_APP_ID=

# GitHub PAT scoped to ONLY `issues:write` on this repo — used by /bug and
# /feature to open issues. Create at https://github.com/settings/personal-
# access-tokens with repository access limited to BearlySleeping/aikami.
# Never widen this scope: it's reachable by anyone who can run a Discord
# slash command in the server.
GITHUB_ISSUES_TOKEN=

# OpenRouter — used by /ask. OPENROUTER_MODEL has no default on purpose:
# pick a current `:free`-suffixed model at
# https://openrouter.ai/models?max_price=0 (free-model availability and
# names change over time, so hardcoding one risks silently breaking later).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
