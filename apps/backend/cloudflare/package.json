{
  "name": "@aikami/cloudflare",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/cli.ts",
  "scripts": {
    "start": "bun run src/cli.ts",
    "build": "moon run cloudflare:build --",
    "build:app": "true",
    "typecheck": "tsgo --noEmit",
    "lint": "biome lint .",
    "format": "biome format .",
    "fix": "biome check --write .",
    "test": "bun test --pass-with-no-tests",
    "deploy": "bun run src/cli.ts"
  },
  "dependencies": {
    "@aikami/constants": "workspace:*",
    "@aikami/logger": "workspace:*",
    "@aikami/schemas": "workspace:*",
    "@aikami/types": "workspace:*",
    "@aikami/utils": "workspace:*",
    "@aikami/backend-database": "workspace:*"
  },
  "devDependencies": {
    "wrangler": "4.128.0"
  }
}
