{
  "name": "@aikami/hub",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite dev --mode emulator",
    "dev:worker": "bun run ../../../scripts/src/lib/ops/run_hub_worker.ts",
    "dev:staging": "vite dev --mode staging",
    "dev:emulator": "vite dev --mode emulator",
    "dev:production": "vite dev --mode production",
    "build": "moon run hub:build --",
    "build:staging": "moon run hub:build -- --mode staging",
    "build:emulator": "moon run hub:build -- --mode emulator",
    "build:production": "moon run hub:build -- --mode production",
    "build:app": "vite build",
    "preview": "vite preview",
    "preview-hub": "bun run ../../../scripts/src/lib/ops/preview_hub.ts",
    "db:migrate:local": "bun run ../../backend/cloudflare/src/cli.ts db migrate --local",
    "db:seed:local": "bun run ../../backend/cloudflare/src/cli.ts db seed --local",
    "check:svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "biome lint src",
    "format": "biome format src",
    "typecheck": "svelte-kit sync && bun ../../../scripts/src/lib/ops/typecheck_svelte.ts --tsconfig ./tsconfig.json",
    "fix": "biome check --write src",
    "test": "bun run test:unit",
    "test:unit": "bunx svelte-kit sync && bun run scripts/write_test_tsconfig.ts && bun test --isolate --preload ./src/lib/test_preload.ts --tsconfig-override=tsconfig.test.json src/lib",
    "deploy": "bun run scripts/deploy.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260902.1",
    "@inlang/paraglide-js": "2.25.0",
    "@libsql/client": "0.18.0",
    "@sveltejs/adapter-cloudflare": "8.0.0-next.6",
    "@sveltejs/kit": "3.0.0-next.25",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.4.1",
    "daisyui": "5.7.27",
    "playwright": "1.62.1",
    "rollup-plugin-visualizer": "7.1.1",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "vite": "8.2.2",
    "vite-plugin-devtools-json": "1.1.0"
  },
  "dependencies": {
    "@aikami/backend-auth": "workspace:*",
    "@aikami/backend-database": "workspace:*",
    "@aikami/backend-project-ai": "workspace:*",
    "@aikami/constants": "workspace:*",
    "@aikami/frontend-preview": "workspace:*",
    "@aikami/frontend-theme": "workspace:*",
    "@aikami/schemas": "workspace:*",
    "@aikami/scripts": "workspace:*",
    "@aikami/types": "workspace:*",
    "@aikami/utils": "workspace:*",
    "@elysiajs/eden": "^1.4.9",
    "drizzle-orm": "^0.45.2",
    "elysia": "1.4.30",
    "eruda": "3.4.3"
  }
}
