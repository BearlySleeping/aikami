{
  "name": "@aikami/hub",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite dev --mode emulator",
    "dev:staging": "vite dev --mode staging",
    "dev:emulator": "vite dev --mode emulator",
    "dev:production": "vite dev --mode production",
    "build": "vite build",
    "build:staging": "vite build --mode staging",
    "build:emulator": "vite build --mode emulator",
    "build:production": "vite build --mode production",
    "preview": "vite preview",
    "preview-hub": "bun run ../../../scripts/src/lib/ops/preview_hub.ts",
    "check:svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "biome lint src",
    "format": "biome format src",
    "typecheck": "svelte-kit sync && bun --bun svelte-fast-check --incremental",
    "fix": "biome check --write src",
    "test": "bun run test:unit",
    "test:unit": "bun test --tsconfig=tsconfig.json src/lib",
    "deploy": "bun run scripts/deploy.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260821.1",
    "@inlang/paraglide-js": "2.24.1",
    "@libsql/client": "^0.17.4",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.2.0",
    "daisyui": "5.7.19",
    "playwright": "1.62.1",
    "rollup-plugin-visualizer": "7.1.1",
    "svelte": "5.56.9",
    "svelte-adapter-bun": "1.0.1",
    "svelte-check": "4.7.6",
    "svelte-fast-check": "^0.4.5",
    "tailwindcss": "4.3.3",
    "vite": "8.2.1",
    "vite-plugin-devtools-json": "1.1.0"
  },
  "dependencies": {
    "@aikami/backend-auth": "workspace:*",
    "@aikami/backend-database": "workspace:*",
    "@aikami/backend-project-ai": "workspace:*",
    "@aikami/constants": "workspace:*",
    "@aikami/frontend/theme": "workspace:*",
    "@aikami/schemas": "workspace:*",
    "@aikami/types": "workspace:*",
    "@aikami/utils": "workspace:*",
    "@elysiajs/eden": "^1.4.9",
    "@google-analytics/data": "*",
    "@google-cloud/secret-manager": "*",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.29",
    "eruda": "3.4.3",
    "firebase": "12.18.0",
    "firebase-admin": "14.3.0"
  }
}
