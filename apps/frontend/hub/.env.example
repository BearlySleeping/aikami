PUBLIC_MODE=production
PUBLIC_APP_ID=hub
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_MEASUREMENT_ID=

APP_ID=hub
MODE=emulator
FIREBASE_SERVICE_ACCOUNT='{}'

# reCAPTCHA Enterprise (for Firebase App Check)
# IMPORTANT: This is NOT legacy reCAPTCHA v3 — you must create a reCAPTCHA Enterprise key.
#
# 1. Go to: https://console.cloud.google.com/security/recaptcha
# 2. Create a new Web site key (score-based)
# 3. Add your domains:
#    - For local dev: localhost
# 4. Copy the site key below.
#
# Then go to Firebase Console > App Check > reCAPTCHA Enterprise and register the key.
PUBLIC_RECAPTCHA_SITE_KEY=

# App Check — set to 1 to disable (emulator), 0 to force-enable in staging.
# In production, App Check is always enabled regardless of this setting.
PUBLIC_DISABLE_APP_CHECK=
# App Check debug token (for emulator/dev mode only)
# Generate with: node -e "console.log(require('crypto').randomUUID())"
PUBLIC_APP_CHECK_DEBUG_TOKEN=

# Neon PostgreSQL 18 (aws-eu-west-2). POOLED endpoint — host contains
# "-pooler". Read server-side only, lazily on first query (C-394).
NEON_DATABASE_URL=

# Neon DIRECT (unpooled) endpoint. Migrations only — DDL under PgBouncer
# transaction pooling is where pooling breaks. Never read by the running
# server; only by the `database` deploy app (C-394 AC-5).
NEON_DATABASE_URL_DIRECT=

# Catalog origin — public CDN base that the static index documents are
# fetched from (C-396). The hub only READS this origin (index/v1/*.json plus
# content-addressed assets/thumbnails); it never writes to R2 (invariant
# I-7). In production this is the public origin recorded in the published
# index, e.g. https://assets.bearlysleeping.com. Unset → the catalog renders
# its explicit error state instead of a blank page.
CATALOG_ORIGIN_URL=

# NOTE: the Cloudflare R2 credentials are deliberately NOT here.
# They are WRITE credentials for the catalog publish pipeline, and the hub
# never writes to R2 (invariant I-7 — the catalog serves URLs, the CDN serves
# bytes, the hub proxies nothing). Every non-PUBLIC_ key in this file is
# mapped to a Cloud Run --set-secrets entry by buildSecretArgsFromEnvFile, so
# listing them here would hand R2 write access to a public-facing service for
# no reason. They live in scripts/.env.* with the rest of the pipeline
# credentials. See C-395.
