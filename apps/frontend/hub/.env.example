# ─── Public (bundled into the hub client build) ──────────────────────────
PUBLIC_APP_ID=hub
PUBLIC_MODE=production

# Valid LogLevel values: NONE, DEBUG, INFO, NOTICE, WARNING, ERROR, CRITICAL, ALERT, EMERGENCY
PUBLIC_LOG_LEVEL=
PUBLIC_LOG_PERSIST_LEVEL=

# ─── Server (Cloudflare Worker) ──────────────────────────────────────────
APP_ID=hub
MODE=emulator

# Valid LogLevel values on backend: NONE, DEBUG, INFO, NOTICE, WARNING, ERROR,
# CRITICAL, ALERT, EMERGENCY
LOG_LEVEL=

# ─── Identity — Better Auth (C-426) ──────────────────────────────────────
# Signing secret for Better Auth sessions. Generate any high-entropy string:
#   bun -e 'console.log(crypto.randomUUID() + crypto.randomUUID())'
BETTER_AUTH_SECRET=
# Public origin the auth callbacks return to (e.g. https://hub.bearlysleeping.com).
# Leave empty locally — defaults to the dev origin.
BETTER_AUTH_URL=

# Google OAuth (optional locally — email/password sign-in works without it).
# Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Data plane ──────────────────────────────────────────────────────────
# D1 and R2 are Worker BINDINGS, not env vars — they are declared in
# wrangler.jsonc (`DB` and `SAVES_BUCKET`) and reach the app through
# `platform.env`. There is nothing to put here for them.
#
# Locally, `wrangler dev` provides both from miniflare with state persisted
# under .wrangler/ — no Cloudflare account required.

# Catalog origin — public CDN base that the static index documents are
# fetched from (C-396). The hub only READS this origin (index/v1/*.json plus
# content-addressed assets/thumbnails); it never writes to R2 (invariant
# I-7). In production this is the public origin recorded in the published
# index, e.g. https://assets.bearlysleeping.com. Unset → the catalog renders
# its explicit error state instead of a blank page.
CATALOG_ORIGIN_URL=

# ─── Landing-page "ask about Aikami" widget ──────────────────────────────
# OpenRouter — POST /api/ask (apps/frontend/hub/src/lib/server/api/ask.ts).
# Same underlying logic as the Discord Interactions Endpoint's /ask
# (apps/backend/worker), via @aikami/backend-project-ai. Unset → the endpoint
# returns { error: 'unconfigured' } instead of a 500. OPENROUTER_MODEL has no
# default on purpose: pick a current `:free`-suffixed model at
# https://openrouter.ai/models?max_price=0 (free-model availability and names
# change over time, so hardcoding one risks silently breaking later).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ─── Deprecated — pending removal in C-436 ───────────────────────────────
# Neon PostgreSQL was the hub's data plane before the D1 migration (C-426).
# The connection code still exists behind `packages/backend/database/src/lib/
# connection.ts` for the rollback window. Leave BLANK: the hub degrades
# cleanly with no Postgres configured, and C-436 deletes this path entirely.

# NOTE: Cloudflare R2 WRITE credentials are deliberately NOT here.
# They belong to the catalog publish pipeline, and the hub never writes to R2
# (invariant I-7 — the catalog serves URLs, the CDN serves bytes, the hub
# proxies nothing). Every non-PUBLIC_ key in this file is mapped into the
# deployed secret set, so listing them here would hand R2 write access to a
# public-facing service for no reason. They live in scripts/.env.* with the
# rest of the pipeline credentials. See C-395.
