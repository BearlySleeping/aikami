// apps/frontend/hub/wrangler.jsonc
// C-426 AC-3: Cloudflare Worker config for the hub (SSR SvelteKit app).
//
// This is the SSR Worker shape (assetsOnly: false) — `main` points at the
// `@sveltejs/adapter-cloudflare` worker entry, `assets` serves the static
// client build. The deploy pipeline rewrites `name`/`routes` per mode via
// scripts/src/lib/deploy/cloudflare.ts (same as client/site/docs).
//
// Bindings:
//   DB          — Cloudflare D1 (the hub's database, C-426 AC-1)
//   SAVES_BUCKET— Cloudflare R2 (Turso save backups, C-426 AC-6/AC-7)
//
// `database_id` / `bucket_name` are provisioned separately (wrangler d1
// create / r2 bucket create) and filled in by the deploy pipeline or a
// maintainer before the first deploy.
//
// C-454: The values below are the production entries from the shared
// D1_DATABASES and R2_BUCKETS constants in
// packages/shared/constants/src/lib/infrastructure.ts.
// wrangler.jsonc cannot import TypeScript, so if you change the production
// values there, update them here too.
//
// `migrations_dir` points wrangler at the Drizzle-generated migration SQL
// in packages/backend/database/drizzle-d1 (the schema source of truth) so
// `wrangler d1 migrations apply` works without a local copy under this app.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aikami-hub",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./build/_worker.js",
  "assets": {
    "directory": "./build/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aikami-hub",
      "database_id": "bf77e365-058f-408f-871c-4a0567c9aa10",
      "migrations_dir": "../../../packages/backend/database/drizzle-d1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SAVES_BUCKET",
      "bucket_name": "aikami-saves"
    }
  ],
  "routes": [{ "pattern": "hub.bearlysleeping.com", "custom_domain": true }]
}
