{
  "name": "@aikami/client",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite dev --mode emulator",
    "dev:staging": "vite dev --mode staging",
    "dev:emulator": "vite dev --mode emulator",
    "dev:production": "vite dev --mode production",
    "build": "moon run client:build --",
    "build:staging": "moon run client:build -- --mode staging",
    "build:emulator": "moon run client:build -- --mode emulator",
    "build:production": "moon run client:build -- --mode production",
    "build:app": "bun scripts/build_client.ts",
    "check:bundle": "bun scripts/check_bundle.ts",
    "update:cors": "bun scripts/update_cors.ts",
    "tauri": "tauri",
    "tauri:icon": "tauri icon ../../../assets/default.svg",
    "tauri:dev": "tauri dev",
    "tauri:run": "bun run ../../../scripts/src/lib/ops/run_tauri.ts",
    "dev:tauri": "bun run build:emulator && cd src-tauri && cargo build && ./target/debug/aikami",
    "deploy": "bun run scripts/deploy.ts",
    "build:tauri": "bun scripts/build_tauri.ts",
    "build:tauri-web": "bun scripts/build_tauri.ts --web-only",
    "preview:tauri": "bun run build:emulator && cd src-tauri && cargo build --features tauri/custom-protocol && ./target/debug/aikami",
    "preview": "vite preview --mode emulator",
    "prepare": "svelte-kit sync || echo ''",
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "lint": "biome lint src",
    "format": "biome format src",
    "typecheck": "svelte-kit sync && bun ../../../scripts/src/lib/ops/typecheck_svelte.ts --tsconfig ./tsconfig.json",
    "fix": "biome check --write src --error-on-warnings",
    "test:unit": "bunx svelte-kit sync && bun scripts/write_test_tsconfig.ts && bun test --isolate --preload ./src/lib/test_setup.ts --tsconfig-override=tsconfig.test.json src/lib",
    "test:browser": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.25.1",
    "@playwright/test": "1.63.0",
    "@sveltejs/adapter-static": "4.0.0-next.4",
    "@sveltejs/kit": "3.0.0-next.27",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/jszip": "^3.4.1",
    "@types/node": "26.5.1",
    "@types/png-chunks-extract": "1.0.2",
    "@types/text-encoding": "0.0.40",
    "@vitest/browser-playwright": "5.0.0",
    "gpt-tokenizer": "4.0.0",
    "playwright": "1.63.0",
    "rollup-plugin-visualizer": "7.1.1",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "vite": "8.3.0",
    "vite-plugin-devtools-json": "1.1.0",
    "vite-plugin-iso-import": "1.3.0",
    "vitest": "5.0.0",
    "wrangler": "4.131.0"
  },
  "dependencies": {
    "@aikami/local-ai": "workspace:*",
    "@aikami/constants": "workspace:*",
    "@aikami/frontend-ai-gateway": "workspace:*",
    "@aikami/frontend-components": "workspace:*",
    "@aikami/frontend-configs": "workspace:*",
    "@aikami/frontend-engine": "workspace:*",
    "@aikami/frontend-local-runtime": "workspace:*",
    "@aikami/frontend-services": "workspace:*",
    "@aikami/frontend-storage": "workspace:*",
    "@aikami/frontend-theme": "workspace:*",
    "@aikami/logger": "workspace:*",
    "@aikami/lpc": "workspace:*",
    "@aikami/mocks": "workspace:*",
    "@aikami/parser": "workspace:*",
    "@aikami/schemas": "workspace:*",
    "@aikami/types": "workspace:*",
    "@aikami/utils": "workspace:*",
    "@huggingface/transformers": "^4.2.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-log": "2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "eruda": "3.4.3",
    "jszip": "3.10.2",
    "kokoro-js": "1.2.1",
    "onnxruntime-web": "1.29.0",
    "pixi.js": "8.20.1",
    "png-chunks-extract": "1.0.0",
    "@aikami/frontend-preview": "workspace:*"
  }
}
