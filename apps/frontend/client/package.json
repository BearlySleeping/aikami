{
  "name": "@aikami/client",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite dev --mode emulator",
    "dev:staging": "vite dev --mode staging",
    "dev:emulator": "vite dev --mode emulator",
    "dev:production": "vite dev --mode production",
    "build": "bun scripts/build_client.ts",
    "build:staging": "bun scripts/build_client.ts --mode staging",
    "build:emulator": "AIKAMI_INCLUDE_DEV_ROUTES=true bun scripts/build_client.ts --mode emulator",
    "build:production": "bun scripts/build_client.ts --mode production",
    "check:bundle": "bun scripts/check_bundle.ts",
    "tauri": "tauri",
    "tauri:icon": "tauri icon ../../../assets/default.svg",
    "tauri:dev": "tauri dev",
    "tauri:build": "bun scripts/tauri_build.ts",
    "tauri:run": "bun run ../../../scripts/src/lib/ops/run_tauri.ts",
    "dev:tauri": "bun run build:emulator && cd src-tauri && cargo build && ./target/debug/aikami",
    "deploy": "bun run scripts/deploy.ts",
    "build:tauri": "bun scripts/build_tauri.ts",
    "build:tauri-web": "bun scripts/build_tauri.ts --web-only",
    "preview:tauri": "bun run build:emulator && cd src-tauri && cargo build --features tauri/custom-protocol && ./target/debug/aikami",
    "preview": "vite preview --mode emulator",
    "prepare": "svelte-kit sync || echo ''",
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "lint": "biome lint src",
    "format": "biome format src",
    "typecheck": "svelte-kit sync && bun --bun svelte-fast-check --incremental",
    "fix": "biome check --write src --error-on-warnings",
    "test:unit": "bun test --isolate --preload ./src/lib/test_preload.ts --tsconfig tsconfig.test.json src/lib"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.24.1",
    "@playwright/test": "1.62.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/jszip": "^3.4.1",
    "@types/node": "26.3.0",
    "@types/png-chunks-extract": "1.0.2",
    "@types/text-encoding": "0.0.40",
    "daisyui": "5.7.22",
    "firebase-tools": "15.28.1",
    "rollup-plugin-visualizer": "7.1.1",
    "svelte": "5.56.10",
    "svelte-check": "4.7.6",
    "svelte-fast-check": "^0.4.5",
    "tailwindcss": "4.3.3",
    "vite": "8.2.2",
    "vite-plugin-devtools-json": "1.1.0",
    "vite-plugin-iso-import": "1.3.0",
    "wrangler": "^4.125.0"
  },
  "dependencies": {
    "@aikami/constants": "workspace:*",
    "@aikami/frontend-components": "workspace:*",
    "@aikami/frontend-services": "workspace:*",
    "@aikami/frontend-utils": "workspace:*",
    "@aikami/frontend/engine": "workspace:*",
    "@aikami/frontend/theme": "workspace:*",
    "@aikami/logger": "workspace:*",
    "@aikami/mocks": "workspace:*",
    "@aikami/parser": "workspace:*",
    "@aikami/schemas": "workspace:*",
    "@aikami/types": "workspace:*",
    "@aikami/utils": "workspace:*",
    "@huggingface/transformers": "^4.2.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-deep-link": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-http": "^2",
    "@tauri-apps/plugin-log": "2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "bitecs": "^0.4.0",
    "device-detector-js": "3.0.3",
    "eruda": "3.4.3",
    "firebase-admin": "14.3.0",
    "jszip": "^3.10.1",
    "kokoro-js": "1.2.1",
    "onnxruntime-web": "1.29.0",
    "pixi.js": "8.20.0",
    "png-chunks-extract": "1.0.0",
    "text-encoding": "0.7.0"
  }
}
