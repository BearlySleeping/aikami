# ─── Public (bundled into the client build) ──────────────────────────────
PUBLIC_APP_ID=client
PUBLIC_MODE=emulator

# Valid LogLevel values: NONE, DEBUG, INFO, NOTICE, WARNING, ERROR, CRITICAL, ALERT, EMERGENCY
PUBLIC_LOG_LEVEL=
PUBLIC_ERUDA_ENABLED=
PUBLIC_LOG_PERSIST_LEVEL=
PUBLIC_PARSE_LEVEL=safe
PUBLIC_SITE_URL=
# Public hub page linked from the client's Advanced section.
PUBLIC_HUB_PAGE_URL=https://hub.bearlysleeping.com

# Base URL for the onnxruntime-web WASM/MJS runtime served from the R2
# distribution plane. Must be an immutable, version-pinned directory that
# exactly matches the `onnxruntime-web` version the app uses
# (packages/frontend/local-runtime/src/lib/ort_runtime.ts → ORT_RUNTIME_VERSION).
# onnxruntime resolves ort-wasm-simd-threaded.{jsep,asyncify}.{mjs,wasm} under it.
# Leave empty to use the version-pinned default (dl.bearlysleeping.com). No ORT
# binary is bundled into the deployable build.
PUBLIC_ORT_WASM_URL=

# Same-origin path to the image generation microservice (sd-server).
# Emulator/dev uses the Vite /api/image proxy; production bundles must not
# embed a localhost URL, so this stays empty for staging/production.
PUBLIC_IMAGE_URL=

# The client is a static Cloudflare Worker with no server of its own —
# browser logs forward cross-origin to hub's /api/internal_logging in
# staging/production. Leave empty in emulator/dev (uses the relative-path
# dev sink instead).
PUBLIC_LOG_ENDPOINT=

# Public R2 origin for de-bundled game assets (C-435). The client ships
# zero game-data — everything (seed, metadata, sprites, maps, music) is
# fetched on demand from this origin and cached locally. REQUIRED: without
# this, the asset catalog cannot load and no game assets resolve.
# Public R2 catalog origin the client reads assets from. Per mode: production
# uses https://assets.bearlysleeping.com, staging uses
# https://assets.stg.bearlysleeping.com. The real value is injected per mode
# from secrets/{mode}.enc.env; this default is only a fallback.
PUBLIC_ASSETS_BASE_URL=https://assets.bearlysleeping.com

# Set to 1 to silence all audible output (BGM, SFX, TTS) by pinning the
# AudioService master gain to zero. Intended for E2E/preview servers and
# automated runs — leave empty for normal play. Build-time flag: export it
# before `bun run build` or the running dev/preview server.
PUBLIC_MUTE_AUDIO=

# Combat resolver selection: leave empty (or set to "legacy") for the shipped
# legacy resolver; set to "v2" to play encounters on the deterministic
# Combat 2.0 engine with direct tactical controls. Read ONCE at encounter start
# — an encounter never changes engine mid-fight (C-516).
PUBLIC_COMBAT_ENGINE=
