# ─── Public (bundled into the client build) ──────────────────────────────
PUBLIC_APP_ID=client
PUBLIC_MODE=production

# Valid LogLevel values: NONE, DEBUG, INFO, NOTICE, WARNING, ERROR, CRITICAL, ALERT, EMERGENCY
PUBLIC_LOG_LEVEL=
PUBLIC_ERUDA_ENABLED=
PUBLIC_LOG_PERSIST_LEVEL=
PUBLIC_PARSE_LEVEL=safe
PUBLIC_SITE_URL=

# Base URL for the vendored onnxruntime-web WASM served from the R2
# distribution plane (e.g. https://dl.bearlysleeping.com/models/ort/1.27.0/).
# onnxruntime appends ort-wasm-simd-threaded.jsep.wasm. Leave empty to serve
# from the app's own /ort/ static dir (C-389). TTS is installed on demand.
PUBLIC_ORT_WASM_URL=

# The client is a static Cloudflare Worker with no server of its own —
# browser logs forward cross-origin to hub's /api/internal_logging in
# staging/production. Leave empty in emulator/dev (uses the relative-path
# dev sink instead).
PUBLIC_LOG_ENDPOINT=

# Public R2 origin for de-bundled game assets (C-435). The client ships
# zero game-data — everything (seed, metadata, sprites, maps, music) is
# fetched on demand from this origin and cached locally. REQUIRED: without
# this, the asset catalog cannot load and no game assets resolve.
# Production/staging: https://assets.bearlysleeping.com
PUBLIC_ASSETS_BASE_URL=https://assets.bearlysleeping.com
