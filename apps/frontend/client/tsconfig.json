{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "strict": true,
    "checkJs": false,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun", "$app/types"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "*.ts",
    ".svelte-kit/ambient.d.ts",
    ".svelte-kit/non-ambient.d.ts",
    ".svelte-kit/types/**/$types.d.ts"
  ],
  "exclude": [
    "node_modules",
    ".svelte-kit",
    "build",
    "src/lib/paraglide/messages",
    "src/**/*.test.ts",
    "src/lib/test_preload.ts"
  ]
}
