---
// apps/frontend/site/src/lib/components/layout/footer.astro
import { discordInviteLink, site, webClientUrl } from '$data/site_content';

const links = [
  { label: 'Download', href: '/#download' },
  { label: 'Play', href: webClientUrl },
  { label: 'FAQ', href: '/faq' },
  { label: 'Blog', href: '/blog' },
  { label: 'Technical guide', href: '/tech' },
  { label: 'Discord', href: discordInviteLink },
  { label: 'GitHub', href: site.social.github },
];
---

<footer class="border-t border-border/70 bg-card/40">
  <div class="mx-auto max-w-6xl px-6 py-10">
    <div class="flex flex-col justify-between gap-5 md:flex-row md:items-center">
      <div>
        <a href="/" class="font-logo text-3xl text-foreground no-underline"
          >Aikami<span class="text-brand dark:text-brand-soft" aria-hidden="true">.</span></a
        >
        <p class="mt-2 text-sm text-muted-foreground">
          An adventure in the making. Built in the open.
        </p>
      </div>
      <nav
        class="flex flex-wrap gap-x-5 gap-y-1 text-sm text-muted-foreground"
        aria-label="Footer navigation"
      >
        {links.map((link) => (
          <a href={link.href} class="inline-flex min-h-11 items-center no-underline hover:text-foreground">{link.label}</a>
        ))}
      </nav>
    </div>
    <div
      class="mt-6 flex flex-col justify-between gap-3 border-t border-border pt-5 text-sm text-muted-foreground sm:flex-row"
    >
      <p>© {new Date().getFullYear()} Aikami</p>
      <p>
        <a href={`${site.social.github}/blob/main/LICENSE`} class="underline underline-offset-4"
          >Code: MIT</a
        >
        · Bundled assets have separate licenses.
      </p>
    </div>
  </div>
</footer>
