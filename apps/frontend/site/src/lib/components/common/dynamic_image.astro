---
// apps/frontend/site/src/lib/components/common/dynamic_image.astro
import type { ImageMetadata, ImageQuality } from 'astro';
import Picture from './picture.astro';

type Props = {
  altText: string;
  class?: string;
  eager?: boolean;
  height?: number;
  imagePath: string;
  width?: number;
  quality?: ImageQuality;
};

const { altText, class: className, eager, height, imagePath, width, quality } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/lib/assets/**/*.{jpeg,jpg,png,gif,webp,avif}',
);

const fullPath = `/src/lib/assets/${imagePath}`;

if (!images[fullPath]) {
  throw new Error(
    `"${fullPath}" does not exist in glob: "/src/lib/assets/**/*.{jpeg,jpg,png,gif,webp,avif}"`,
  );
}

const imageModule = await images[fullPath]();
const image = imageModule.default;
---

<Picture
  alt={altText}
  class={className}
  height={height}
  loading={eager ? 'eager' : 'lazy'}
  src={image}
  width={width}
  quality={quality}
/>
