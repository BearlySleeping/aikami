---
// apps/frontend/site/src/lib/components/common/image_preview.astro
import type { ImageMetadata } from 'astro';
import Picture from '$components/common/picture.astro';

type Props = {
  id: string;
  image: ImageMetadata;
  title: string;
  alt: string;
  description: string;
};

const { id, image, title, alt, description } = Astro.props;
---

<div data-image-preview>
  <button
    type="button"
    data-preview-trigger
    data-full-size-src={image.src}
    aria-label={`Open full-size concept: ${title}`}
    aria-haspopup="dialog"
    aria-controls={id}
    class="group relative block aspect-video w-full cursor-zoom-in overflow-hidden rounded-sm border border-border bg-card p-0 text-left hover:border-brand focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand"
  >
    <Picture
      src={image}
      alt={alt}
      formats={['webp']}
      fallbackFormat="webp"
      widths={[480, 832, 1200, 1672]}
      sizes="(min-width: 1152px) 536px, (min-width: 768px) calc((100vw - 80px) / 2), calc(100vw - 48px)"
      width={image.width}
      height={image.height}
      loading="lazy"
      decoding="async"
      class="block h-full w-full object-cover"
    />
    <span
      class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-background via-background/90 to-transparent px-5 pb-5 pt-16 text-foreground opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-visible:opacity-100 [@media(hover:none)]:opacity-100 motion-reduce:transition-none"
    >
      <span class="block font-serif text-2xl md:text-3xl">{title}</span>
      <span class="mt-1 block max-w-2xl text-sm leading-relaxed text-muted-foreground md:text-base">
        {description}
      </span>
    </span>
  </button>
  <dialog
    id={id}
    aria-labelledby={`${id}-title`}
    closedby="any"
    class="fixed inset-0 m-0 h-[100dvh] max-h-none w-screen max-w-none items-center justify-center border-0 bg-transparent p-6 text-foreground backdrop:bg-background/95 open:flex"
  >
    <form method="dialog">
      <button
        type="submit"
        aria-label="Dismiss image preview"
        class="absolute inset-0 z-0 cursor-zoom-out bg-transparent"
      ></button>
      <button
        type="submit"
        aria-label="Close full-size preview"
        autofocus
        class="absolute right-4 top-4 z-20 inline-flex size-11 items-center justify-center rounded-sm border border-border bg-card text-foreground hover:bg-secondary focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="m6 6 12 12M18 6 6 18"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          />
        </svg>
      </button>
    </form>
    <figure class="relative z-10 m-0 flex max-w-full flex-col items-center">
      <Picture
        src={image.src}
        alt={alt}
        formats={['webp']}
        fallbackFormat="webp"
        width={image.width}
        height={image.height}
        loading="lazy"
        decoding="async"
        class="block h-auto max-h-[calc(100dvh-8rem)] w-auto max-w-full object-contain"
      />
      <figcaption id={`${id}-title`} class="mt-3 rounded-sm bg-card px-3 py-1 text-center text-sm">
        {title}
      </figcaption>
    </figure>
  </dialog>
</div>

<script>
import { logger } from '$logger';

for (const preview of document.querySelectorAll('[data-image-preview]')) {
  logger.debug('ImagePreview:initialize');
  const trigger = preview.querySelector('[data-preview-trigger]');
  const dialog = preview.querySelector('dialog');
  if (!(trigger instanceof HTMLButtonElement) || !(dialog instanceof HTMLDialogElement)) {
    continue;
  }

  let previousOverflow = '';
  trigger.addEventListener('click', () => {
    logger.debug('ImagePreview:open');
    previousOverflow = document.documentElement.style.overflow;
    document.documentElement.style.overflow = 'hidden';
    trigger.focus({ preventScroll: true });
    dialog.showModal();
  });

  dialog.addEventListener('close', () => {
    logger.debug('ImagePreview:close');
    document.documentElement.style.overflow = previousOverflow;
    trigger.focus({ preventScroll: true });
  });
}
</script>
