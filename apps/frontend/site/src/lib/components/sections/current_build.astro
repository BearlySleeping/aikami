---
// apps/frontend/site/src/lib/components/sections/current_build.astro
import { PUBLIC_GITHUB_REPO } from 'astro:env/client';
import { webClientUrl } from '$data/site_content';

const repositoryUrl = `https://github.com/${PUBLIC_GITHUB_REPO || 'BearlySleeping/aikami'}`;
const downloads = [
  { label: 'Windows', asset: 'aikami.exe', format: 'Windows installer · .exe' },
  { label: 'macOS', asset: 'aikami.dmg', format: 'macOS disk image · .dmg' },
  { label: 'Linux', asset: 'aikami.appimage', format: 'Linux AppImage · .appimage' },
];
---

<section id="current-build" class="scroll-mt-24 border-b border-border/70">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 py-16 md:py-20 lg:grid-cols-2 lg:gap-16">
    <div>
      <p class="text-sm font-medium text-brand dark:text-brand-soft">03 / Current build</p>
      <h2 class="mt-4 text-4xl leading-[1.08] md:text-5xl">Begin in <em>Emberwatch.</em></h2>
      <p class="mt-5 max-w-lg leading-relaxed text-muted-foreground">
        The village’s protective ward is fading. The Ward Wand is in the hands of a rogue at the
        inn. Recover it through persuasion or combat.
      </p>
      <p class="mt-4 max-w-lg leading-relaxed text-muted-foreground">
        <span class="text-foreground">The Fading Ward</span>
        is Aikami’s authored starter adventure. The early build includes spatial exploration and
        private narrative drafts. Expect rough edges as we refine onboarding and quest decisions.
      </p>
      <a
        href={webClientUrl}
        class="mt-6 inline-flex min-h-12 items-center gap-3 rounded-sm border border-border px-6 py-3 font-medium text-foreground no-underline hover:border-brand"
      >
        Play in your browser <span aria-hidden="true">↗</span>
      </a>
    </div>
    <aside
      id="download"
      aria-labelledby="download-title"
      class="scroll-mt-24 rounded-sm border border-border bg-card p-6 sm:p-8"
    >
      <p class="text-sm font-medium text-brand dark:text-brand-soft">Take the adventure with you</p>
      <h3 id="download-title" class="mt-3 text-3xl sm:text-4xl">Download for desktop.</h3>
      <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
        Aikami on your own machine. Choose your platform.
      </p>
      <ul class="mt-6 space-y-3">
        {downloads.map((download) => (
          <li>
            <a href={`${repositoryUrl}/releases/latest/download/${download.asset}`} class="group flex min-h-20 items-center justify-between gap-4 rounded-sm border border-border bg-background px-5 py-4 text-foreground no-underline hover:border-brand">
              <span>
                <span class="block font-medium">Download for {download.label}</span>
                <span class="mt-1 block text-sm text-muted-foreground">{download.format}</span>
              </span>
              <span aria-hidden="true" class="text-xl text-brand dark:text-brand-soft">↓</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-5 text-sm leading-relaxed text-muted-foreground">
        Text AI setup required. Linux requires glibc 2.35+ and libfuse2.
      </p>
      <a
        href={`${repositoryUrl}/releases`}
        class="mt-2 inline-flex min-h-11 items-center text-sm text-muted-foreground underline underline-offset-4"
        >Release notes</a
      >
    </aside>
  </div>
</section>
