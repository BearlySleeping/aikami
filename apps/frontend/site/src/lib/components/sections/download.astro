---
// apps/frontend/site/src/lib/components/sections/download.astro
/**
 * Download Section — Tauri desktop release downloads from GitHub Releases.
 *
 * Client-side: resolves the GitHub releases for the `stable` (newest
 * production / non-prerelease release) and `latest` (newest release, may
 * include prereleases) channels, then shows download buttons for Linux,
 * macOS and Windows with live file sizes.
 *
 * Staging never publishes official releases — staging workflow runs only
 * produce ephemeral workflow artifacts — so this section only ever links to
 * production GitHub Releases.
 */

import { PUBLIC_GITHUB_REPO } from 'astro:env/client';

const REPO = PUBLIC_GITHUB_REPO || '';

type PlatformDef = {
  id: string;
  label: string;
  ext: string;
  icon: string;
};

const PLATFORMS: PlatformDef[] = [
  { id: 'linux', label: 'Linux', ext: '.appimage', icon: 'linux' },
  { id: 'macos', label: 'macOS', ext: '.dmg', icon: 'apple' },
  { id: 'windows', label: 'Windows', ext: '.exe', icon: 'windows' },
] as const;

const CHANNELS = [
  { id: 'stable', label: 'Stable', description: 'Production release' },
  { id: 'latest', label: 'Latest', description: 'Newest release' },
] as const;
---

<section id="download" class="border-b border-border/70 bg-card">
  <div class="mx-auto max-w-6xl px-6 py-24 md:py-28">
    <div class="max-w-2xl">
      <span class="eyebrow text-emerald-400">Download</span>
      <h2 class="mt-5 font-serif text-4xl md:text-5xl leading-tight">Get the desktop client.</h2>
      <p class="mt-5 text-muted-foreground leading-relaxed">
        Download the native Tauri desktop app for Linux, macOS, or Windows. Same world, same NPCs —
        with full offline support and local AI.
      </p>
    </div>

    <!-- Channel Toggle -->
    <div id="download-root" class="mt-10" data-repo={REPO}>
      <div class="flex justify-center gap-2 mb-8">
        {CHANNELS.map((ch) => (
          <button
            type="button"
            class={`download-channel-btn rounded-sm px-5 py-2 text-sm font-medium transition-colors ${ch.id === 'stable' ? 'bg-primary text-primary-foreground' : 'border border-border bg-card text-foreground hover:bg-muted'}`}
            data-channel={ch.id}
          >
            {ch.label}
          </button>
        ))}
      </div>

      <!-- Platform Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-3xl mx-auto" id="download-cards">
        {PLATFORMS.map((p) => (
          <div
            class="download-card rune-border p-6 bg-background/50 text-center transition-opacity"
            data-platform={p.id}
            data-ext={p.ext}
          >
            <div class="flex items-center justify-center mb-4">
              {p.id === 'linux' ? (
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="var(--rune)" stroke-width="1.2" aria-hidden="true">
                  <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2z"/>
                  <path d="M8 14s1.5 2 4 2 4-2 4-2"/>
                  <path d="M9 9h.01M15 9h.01"/>
                  <circle cx="7.5" cy="10.5" r="1.5"/><circle cx="16.5" cy="10.5" r="1.5"/>
                </svg>
              ) : p.id === 'macos' ? (
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="var(--ember)" stroke-width="1.2" aria-hidden="true">
                  <path d="M12 2c-.9 2.5-2 5-2 8 0 2 1 4 2 4s2-2 2-4c0-3-1.1-5.5-2-8z"/>
                  <path d="M17.5 6.5C15.5 8 14 11 14 14c0 2 1 4 2 4s2-2 2-4c0-2-.2-5.5-.5-7.5z"/>
                  <path d="M6.5 6.5C8.5 8 10 11 10 14c0 2-1 4-2 4s-2-2-2-4c0-2 .2-5.5.5-7.5z"/>
                </svg>
              ) : (
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="var(--ember)" stroke-width="1.2" aria-hidden="true">
                  <rect x="1" y="3" width="22" height="14" rx="1"/>
                  <path d="M6 21h12M12 17v4"/>
                </svg>
              )}
            </div>

            <p class="font-mono text-[10px] uppercase tracking-widest text-muted-foreground mb-2">
              {p.label}
            </p>

            <a
              href="/download"
              aria-label={`Download Aikami desktop client for ${p.label}`}
              class="download-link inline-flex items-center justify-center rounded-sm px-5 py-2.5 text-sm font-medium transition-all no-underline w-full border border-border bg-card text-foreground hover:bg-muted"
              data-platform={p.id}
            >
              <span class="download-label">Download</span>
            </a>

            <p class="download-status mt-3 text-xs text-muted-foreground">Checking…</p>
          </div>
        ))}
      </div>

      <!-- Detected OS badge -->
      <p id="download-os-badge" class="text-center mt-6 text-xs text-muted-foreground hidden">
        Detected OS: <span id="download-os-name" class="font-mono text-rune"></span>
      </p>
    </div>
  </div>
</section>

<script>
// apps/frontend/site/src/lib/components/sections/download.astro (client script)

const ROOT = document.getElementById('download-root') as HTMLElement | null;
const REPO = ROOT?.dataset.repo || '';

type Platform = { id: string; label: string; ext: string };
// GitHub API returns snake_case field names — keep them verbatim in the types.
// biome-ignore lint/style/useNamingConvention: GitHub API field name
type ReleaseAsset = { name: string; size: number; browser_download_url: string };
// biome-ignore lint/style/useNamingConvention: GitHub API field names
type Release = { tag_name: string; prerelease: boolean; assets: ReleaseAsset[] };
type ChannelId = 'stable' | 'latest';

const PLATFORM_DEFS: Platform[] = [
  { id: 'linux', label: 'Linux', ext: '.appimage' },
  { id: 'macos', label: 'macOS', ext: '.dmg' },
  { id: 'windows', label: 'Windows', ext: '.exe' },
];

const CHANNEL_IDS: ChannelId[] = ['stable', 'latest'];

/** Detect the user's OS from navigator.userAgent. */
function detectOS(): string {
  const ua = navigator.userAgent.toLowerCase();
  if (ua.includes('win')) {
    return 'windows';
  }
  if (ua.includes('mac')) {
    return 'macos';
  }
  return 'linux';
}

/** Canonical asset name for a platform (aikami.appimage, aikami.exe, …). */
function assetName(ext: string): string {
  return `aikami${ext}`;
}

function formatSize(bytes: number): string {
  if (bytes < 1024 * 1024) {
    return `${(bytes / 1024).toFixed(0)} KB`;
  }
  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
}

async function fetchWithTimeout(url: string, ms = 5_000): Promise<Response> {
  return fetch(url, { signal: AbortSignal.timeout(ms) });
}

/**
 * Resolve the per-channel releases from the GitHub API.
 *  - stable: newest release that is NOT a prerelease (production)
 *  - latest: newest release overall (may include prereleases)
 * Staging has no official releases — workflow artifacts only — so it never
 * appears as a channel here.
 */
async function resolveChannels(): Promise<Record<ChannelId, Release | null>> {
  const res = await fetchWithTimeout(`https://api.github.com/repos/${REPO}/releases?per_page=10`);
  if (!res.ok) {
    return { stable: null, latest: null };
  }
  const releases = (await res.json()) as Release[];
  return {
    latest: releases[0] ?? null,
    stable: releases.find((r) => !r.prerelease) ?? null,
  };
}

/** Find the platform's asset inside a release. */
function findAsset(release: Release, platform: Platform): ReleaseAsset | undefined {
  const want = assetName(platform.ext);
  return (
    release.assets.find((a) => a.name === want) ??
    release.assets.find((a) => a.name.toLowerCase().endsWith(platform.ext))
  );
}

/** Rate-limit fallback: /releases/latest/download/<asset> needs no API call. */
function fallbackUrl(platform: Platform): string {
  return `https://github.com/${REPO}/releases/latest/download/${assetName(platform.ext)}`;
}

function setLinkState(
  card: HTMLElement,
  state: 'ok' | 'missing' | 'unconfigured',
  opts: { href?: string; label: string; status: string; userOS: string; platform: Platform },
): void {
  const link = card.querySelector<HTMLAnchorElement>('.download-link');
  const label = card.querySelector<HTMLElement>('.download-label');
  const status = card.querySelector<HTMLElement>('.download-status');
  if (!link || !label || !status) {
    return;
  }

  link.className =
    'download-link inline-flex items-center justify-center rounded-sm px-5 py-2.5 text-sm font-medium transition-all no-underline w-full border border-border bg-card text-foreground hover:bg-muted';
  link.removeAttribute('download');
  card.style.opacity = '1';
  label.textContent = opts.label;
  status.textContent = opts.status;

  if (state === 'ok' && opts.href) {
    link.href = opts.href;
    link.setAttribute('download', '');
    link.setAttribute('aria-label', `Download Aikami desktop client for ${opts.platform.label}`);
    // Highlight the detected OS card
    if (opts.platform.id === opts.userOS) {
      link.className = link.className
        .replace(/bg-card/, 'bg-primary')
        .replace(/text-foreground/, 'text-primary-foreground')
        .replace(/hover:bg-muted/, 'hover:opacity-90');
    }
    return;
  }
  if (state === 'missing') {
    link.removeAttribute('href');
    link.setAttribute('aria-label', 'Unavailable — Coming soon');
    card.style.opacity = '0.5';
    return;
  }
  link.removeAttribute('href');
  link.setAttribute('aria-label', 'Unavailable — Not configured');
  card.style.opacity = '0.4';
}

/** Main init — runs on DOMContentLoaded. */
async function init(): Promise<void> {
  const userOS = detectOS();

  const osBadge = document.getElementById('download-os-badge');
  const osName = document.getElementById('download-os-name');
  if (osBadge && osName) {
    osBadge.classList.remove('hidden');
    osName.textContent = PLATFORM_DEFS.find((p) => p.id === userOS)?.label ?? userOS;
  }

  const cards = Array.from(document.querySelectorAll<HTMLElement>('.download-card'));

  if (!REPO) {
    for (const card of cards) {
      const platform = PLATFORM_DEFS.find((p) => p.id === card.dataset.platform);
      if (!platform) {
        continue;
      }
      setLinkState(card, 'unconfigured', {
        label: 'Unavailable',
        status: 'Not configured',
        userOS,
        platform,
      });
    }
    return;
  }

  let channels: Record<ChannelId, Release | null>;
  try {
    channels = await resolveChannels();
  } catch {
    channels = { stable: null, latest: null };
  }

  // API unreachable / rate-limited → fall back to direct /releases/latest URLs
  if (!channels.stable && !channels.latest) {
    for (const card of cards) {
      const platform = PLATFORM_DEFS.find((p) => p.id === card.dataset.platform);
      if (!platform) {
        continue;
      }
      setLinkState(card, 'ok', {
        href: fallbackUrl(platform),
        label: 'Download',
        status: 'latest',
        userOS,
        platform,
      });
    }
    return;
  }

  // Default to the channel that has a release (stable wins when both exist)
  let activeChannel: ChannelId = 'stable';
  if (!channels.stable && channels.latest) {
    activeChannel = 'latest';
  }

  function renderChannel(): void {
    const release = channels[activeChannel];
    for (const card of cards) {
      const platform = PLATFORM_DEFS.find((p) => p.id === card.dataset.platform);
      if (!platform) {
        continue;
      }
      if (!release) {
        setLinkState(card, 'missing', {
          label: 'Coming soon',
          status: 'Not yet available',
          userOS,
          platform,
        });
        continue;
      }
      const asset = findAsset(release, platform);
      if (asset) {
        setLinkState(card, 'ok', {
          href: asset.browser_download_url,
          label: asset.size ? `Download (${formatSize(asset.size)})` : 'Download',
          status: release.tag_name,
          userOS,
          platform,
        });
      } else {
        setLinkState(card, 'missing', {
          label: 'Coming soon',
          status: 'Not in this release',
          userOS,
          platform,
        });
      }
    }
  }

  const activeBtnClass =
    'download-channel-btn rounded-sm px-5 py-2 text-sm font-medium transition-colors bg-primary text-primary-foreground';
  const inactiveBtnClass =
    'download-channel-btn rounded-sm px-5 py-2 text-sm font-medium transition-colors border border-border bg-card text-foreground hover:bg-muted';

  const channelButtons = document.querySelectorAll<HTMLButtonElement>('.download-channel-btn');
  const applyButtonState = (): void => {
    for (const btn of channelButtons) {
      btn.className = btn.dataset.channel === activeChannel ? activeBtnClass : inactiveBtnClass;
    }
  };

  // Channel toggle buttons
  for (const btn of channelButtons) {
    btn.addEventListener('click', () => {
      const id = (btn.dataset.channel ?? 'stable') as ChannelId;
      if (!CHANNEL_IDS.includes(id)) {
        return;
      }
      activeChannel = id;
      applyButtonState();
      renderChannel();
    });
  }

  applyButtonState();
  renderChannel();
}

document.addEventListener('DOMContentLoaded', init);
</script>
