---
// apps/frontend/site/src/lib/components/sections/download.astro
/**
 * Download Section — Tauri desktop release downloads from GitHub Releases.
 *
 * Direct, API-free download links: Tauri publishes deterministic asset names
 * (`aikami.AppImage`, `aikami.deb`, `aikami.rpm`, `aikami.dmg`, `aikami.exe`)
 * under `/releases/latest/download/`, so no GitHub API call is needed — the
 * buttons always resolve, even when the API is rate-limited. Linux detects
 * the best package format (deb / rpm / AppImage); every card keeps a
 * "View releases" link underneath.
 *
 * Staging never publishes official releases — staging workflow runs only
 * produce ephemeral workflow artifacts — so this section only ever links to
 * production GitHub Releases. There is no stable/latest channel split:
 * `/releases/latest` is already the newest non-prerelease.
 */

import { PUBLIC_GITHUB_REPO } from 'astro:env/client';

const REPO = PUBLIC_GITHUB_REPO || 'BearlySleeping/aikami';

type PlatformDef = {
  id: string;
  label: string;
  /** Default asset extension for the platform (Linux swaps per format). */
  ext: string;
  icon: string;
  /** Button label shown when no format-specific label is needed. */
  buttonLabel: string;
  /** Status line under the button. */
  status: string;
};

const PLATFORMS: PlatformDef[] = [
  {
    id: 'linux',
    label: 'Linux',
    ext: '.AppImage',
    icon: 'linux',
    buttonLabel: 'Download for Linux',
    status: 'AppImage · .deb · .rpm',
  },
  {
    id: 'macos',
    label: 'macOS',
    ext: '.dmg',
    icon: 'apple',
    buttonLabel: 'Download for macOS',
    status: 'Universal .dmg',
  },
  {
    id: 'windows',
    label: 'Windows',
    ext: '.exe',
    icon: 'windows',
    buttonLabel: 'Download for Windows',
    status: 'Installer (.exe)',
  },
] as const;

/** Linux package formats offered, in display order. */
const LINUX_FORMATS = [
  { id: 'appimage', ext: '.AppImage', label: 'AppImage' },
  { id: 'deb', ext: '.deb', label: '.deb' },
  { id: 'rpm', ext: '.rpm', label: '.rpm' },
] as const;

const releasesHref = `https://github.com/${REPO}/releases`;

/** Direct download URL for an asset: no API call, never rate-limited. */
const downloadUrl = (ext: string): string =>
  `https://github.com/${REPO}/releases/latest/download/aikami${ext}`;
---

<section id="download" class="border-b border-border/70 bg-card">
  <div class="mx-auto max-w-6xl px-6 py-24 md:py-28">
    <div class="max-w-2xl">
      <span class="eyebrow text-emerald-400">Download</span>
      <h2 class="mt-5 font-serif text-4xl md:text-5xl leading-tight">Get the desktop client.</h2>
      <p class="mt-5 text-muted-foreground leading-relaxed">
        Download the native Tauri desktop app for Linux, macOS, or Windows. Same world, same NPCs —
        with full offline support and local AI.
      </p>
    </div>

    <!-- Platform Cards -->
    <div id="download-root" class="mt-10" data-repo={REPO}>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-3xl mx-auto" id="download-cards">
        {PLATFORMS.map((p) => (
          <div
            class="download-card rune-border p-6 bg-background/50 text-center transition-opacity"
            data-platform={p.id}
            data-ext={p.ext}
          >
            <div class="flex items-center justify-center mb-4">
              {p.id === 'linux' ? (
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="var(--rune)" stroke-width="1.2" aria-hidden="true">
                  <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2z"/>
                  <path d="M8 14s1.5 2 4 2 4-2 4-2"/>
                  <path d="M9 9h.01M15 9h.01"/>
                  <circle cx="7.5" cy="10.5" r="1.5"/><circle cx="16.5" cy="10.5" r="1.5"/>
                </svg>
              ) : p.id === 'macos' ? (
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="var(--ember)" stroke-width="1.2" aria-hidden="true">
                  <path d="M12 2c-.9 2.5-2 5-2 8 0 2 1 4 2 4s2-2 2-4c0-3-1.1-5.5-2-8z"/>
                  <path d="M17.5 6.5C15.5 8 14 11 14 14c0 2 1 4 2 4s2-2 2-4c0-2-.2-5.5-.5-7.5z"/>
                  <path d="M6.5 6.5C8.5 8 10 11 10 14c0 2-1 4-2 4s-2-2-2-4c0-2 .2-5.5.5-7.5z"/>
                </svg>
              ) : (
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="var(--ember)" stroke-width="1.2" aria-hidden="true">
                  <rect x="1" y="3" width="22" height="14" rx="1"/>
                  <path d="M6 21h12M12 17v4"/>
                </svg>
              )}
            </div>

            <p class="font-mono text-[10px] uppercase tracking-widest text-muted-foreground mb-2">
              {p.label}
            </p>

            <a
              href={downloadUrl(p.ext)}
              class="download-link inline-flex items-center justify-center rounded-sm bg-rune px-5 py-2.5 text-sm font-medium text-white transition-all hover:opacity-90 no-underline w-full shadow-rune"
              data-platform={p.id}
              aria-label={`Download Aikami desktop client for ${p.label}`}
            >
              <span class="download-label">{p.buttonLabel}</span>
            </a>

            {p.id === 'linux' && (
              <div class="mt-3 flex justify-center gap-1.5">
                {LINUX_FORMATS.map((f) => (
                  <button
                    type="button"
                    class="linux-format-chip rounded-full border border-rune/40 bg-rune/5 px-3 py-1 text-[11px] font-mono text-rune hover:bg-rune/15 transition-colors"
                    data-format={f.id}
                    data-ext={f.ext}
                    aria-pressed="false"
                  >
                    {f.label}
                  </button>
                ))}
              </div>
            )}

            <p class="download-status mt-3 text-xs text-muted-foreground">{p.status}</p>

            <a
              href={releasesHref}
              target="_blank"
              rel="noopener"
              class="mt-2 inline-flex items-center gap-1 text-[11px] text-muted-foreground/70 hover:text-rune transition-colors no-underline"
            >
              View releases
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M7 17L17 7M7 7h10v10" />
              </svg>
            </a>
          </div>
        ))}
      </div>

      <!-- Detected OS badge -->
      <p id="download-os-badge" class="text-center mt-6 text-xs text-muted-foreground hidden">
        Detected OS: <span id="download-os-name" class="font-mono text-rune"></span>
      </p>
    </div>
  </div>
</section>

<script>
// apps/frontend/site/src/lib/components/sections/download.astro (client script)

/**
 * Detect the user's OS from navigator.userAgent.
 * Mobile check happens first: iPhone/iPad/iPod report "Macintosh"/"Mac OS X"
 * and Android reports no desktop marker, so they are classified as 'unknown'
 * rather than macos or linux. Returns a supported desktop platform id
 * ('windows' | 'macos' | 'linux') or 'unknown'.
 */
function detectOS(): string {
  const ua = navigator.userAgent.toLowerCase();
  if (/iphone|ipad|ipod|android/.test(ua)) {
    return 'unknown';
  }
  if (ua.includes('win')) {
    return 'windows';
  }
  if (ua.includes('mac')) {
    return 'macos';
  }
  return 'linux';
}

/**
 * Best Linux package format for the user's distro, from UA hints.
 * Debian/Ubuntu → .deb, Fedora/RHEL/SUSE → .rpm, anything else → AppImage.
 */
function detectLinuxFormat(): 'appimage' | 'deb' | 'rpm' {
  const ua = navigator.userAgent.toLowerCase();
  if (/\b(ubuntu|debian|mint|elementary)\b/.test(ua)) {
    return 'deb';
  }
  if (/\b(fedora|red ?hat|centos|rhel|rocky|alma|opensuse|suse)\b/.test(ua)) {
    return 'rpm';
  }
  return 'appimage';
}

const ACTIVE_CHIP =
  'linux-format-chip rounded-full border border-rune bg-rune/20 px-3 py-1 text-[11px] font-mono text-rune font-medium';
const INACTIVE_CHIP =
  'linux-format-chip rounded-full border border-rune/40 bg-rune/5 px-3 py-1 text-[11px] font-mono text-rune hover:bg-rune/15 transition-colors';

function init(): void {
  const userOS = detectOS();
  const isSupportedDesktop = userOS !== 'unknown';

  // Detected OS badge — only shown for a supported desktop OS
  const osBadge = document.getElementById('download-os-badge');
  const osName = document.getElementById('download-os-name');
  if (isSupportedDesktop && osBadge && osName) {
    osBadge.classList.remove('hidden');
    osName.textContent = userOS.charAt(0).toUpperCase() + userOS.slice(1);
  }

  // Highlight the detected OS card's download button (desktop OS only)
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.download-card'));
  for (const card of cards) {
    if (isSupportedDesktop && card.dataset.platform === userOS) {
      const link = card.querySelector<HTMLAnchorElement>('.download-link');
      link?.classList.add('ring-1', 'ring-rune/40');
    }
  }

  // Linux: pre-select the detected package format
  const linuxCard = cards.find((c) => c.dataset.platform === 'linux');
  if (linuxCard) {
    const link = linuxCard.querySelector<HTMLAnchorElement>('.download-link');
    const status = linuxCard.querySelector<HTMLElement>('.download-status');
    const chips = Array.from(linuxCard.querySelectorAll<HTMLButtonElement>('.linux-format-chip'));
    const detected = detectLinuxFormat();

    const applyFormat = (format: { id: string; ext: string; label: string }): void => {
      if (!link || !status) {
        return;
      }
      link.href = `https://github.com/${linuxCard.dataset.repo || 'BearlySleeping/aikami'}/releases/latest/download/aikami${format.ext}`;
      link.setAttribute('aria-label', `Download Aikami desktop client for Linux (${format.label})`);
      status.textContent =
        format.id === 'appimage'
          ? 'AppImage — works on any distro'
          : `${format.label} — detected for your distro`;
      for (const chip of chips) {
        const active = chip.dataset.format === format.id;
        chip.className = active ? ACTIVE_CHIP : INACTIVE_CHIP;
        chip.setAttribute('aria-pressed', String(active));
      }
    };

    // Repo is available via the root element's data-repo (set in frontmatter)
    const root = document.getElementById('download-root');
    if (root) {
      linuxCard.dataset.repo = root.dataset.repo || 'BearlySleeping/aikami';
    }

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        applyFormat({
          id: chip.dataset.format ?? 'appimage',
          ext: chip.dataset.ext ?? '.AppImage',
          label: chip.textContent ?? 'AppImage',
        });
      });
    }
    applyFormat({
      id: detected,
      ext: detected === 'appimage' ? '.AppImage' : `.${detected}`,
      label: detected === 'appimage' ? 'AppImage' : `.${detected}`,
    });
  }
}

document.addEventListener('DOMContentLoaded', init);
</script>
