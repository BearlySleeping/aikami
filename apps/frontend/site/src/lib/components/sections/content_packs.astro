---
// apps/frontend/site/src/lib/components/sections/content_packs.astro
/**
 * Content Packs & the Hub — worlds are shareable, structured data, not a
 * single fixed demo. Example cards are built from the real content-pack
 * manifests in the repo's content-pack sources (content/packs),
 * so names and descriptions stay in sync with the actual game data.
 */
import { hubUrl } from '$data/site_content';
import emberwatchManifest from '../../../../../../../content/packs/emberwatch/manifest.json';

type PackCard = {
  name: string;
  hook: string;
  tags: string[];
  real?: boolean;
};

const emberwatch: PackCard = {
  name: emberwatchManifest.name,
  hook: emberwatchManifest.description,
  tags: ['Quest', 'Persuasion', 'Combat', 'Faction system'],
  real: true,
};

const comingSoon: PackCard = {
  name: 'Your Pack Here',
  hook: 'A village of your own — or an entire campaign — authored, remixed, and published to the Hub.',
  tags: ['Create', 'Remix', 'Publish'],
  real: false,
};
---

<section id="content-packs" class="border-b border-border/70">
  <div class="mx-auto max-w-6xl px-6 py-24 md:py-28">
    <div class="max-w-2xl">
      <span class="eyebrow text-indigo-400">Content Packs &amp; the Hub</span>
      <h2 class="mt-5 font-serif text-4xl md:text-5xl leading-tight">
        Worlds are data. Share them like mods.
      </h2>
      <p class="mt-5 text-muted-foreground leading-relaxed">
        Every world in Aikami — maps, tilesets, sprites, props, NPCs, items, dialogue, quests,
        encounters, factions — is defined in a structured content pack, not hardcoded into the
        engine. Packs can be generated by AI or written and edited by hand, and they're plain files:
        copy one, change a line, and the whole world shifts.
      </p>
      <p class="mt-4 text-muted-foreground leading-relaxed">
        The pack that ships with Aikami,
        <span class="text-foreground">Emberwatch: The Fading Ward</span>, is a full village built
        from a single manifest file — an inn, a merchant, a persuasion-or-combat encounter, a
        faction system, and a branching quest, all described in one document. Here's a look at
        what's already in the wild:
      </p>
    </div>

    <!-- Pack teaser cards -->
    <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-6">
      {[emberwatch, comingSoon].map((pack) => (
        <div class="glass-panel p-6 flex flex-col group hover:border-indigo-400/40 transition-colors">
          <div class="flex items-center justify-between mb-3">
            <h3 class="font-serif text-2xl leading-tight">{pack.name}</h3>
            {!pack.real && (
              <span
                class="rounded-full border border-border bg-muted px-2.5 py-0.5 text-[10px] font-mono uppercase tracking-wider text-muted-foreground"
              >
                Coming soon
              </span>
            )}
          </div>
          <p class="text-sm text-muted-foreground leading-relaxed flex-1">{pack.hook}</p>
          <div class="mt-5 flex flex-wrap gap-1.5">
            {pack.tags.map((tag) => (
              <span
                class="rounded-full bg-indigo-400/5 border border-indigo-400/20 px-2.5 py-0.5 text-[10px] font-mono text-indigo-400/90"
              >
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Hub explainer + CTA -->
    <div class="mt-12 rune-border p-8 bg-card/50 backdrop-blur">
      <div class="flex flex-col md:flex-row md:items-center gap-6 md:gap-10">
        <div class="flex-1">
          <div class="flex flex-wrap items-center gap-3">
            <h3 class="font-serif text-2xl leading-tight">
              The Hub: browse, upload, remix, publish.
            </h3>
            <span
              class="inline-flex items-center gap-2 rounded-full border border-ember/30 bg-ember/10 px-3 py-1 font-mono text-[10px] uppercase tracking-widest text-ember"
            >
              <span class="h-1.5 w-1.5 rounded-full bg-ember" aria-hidden="true"></span>
              Early WIP
            </span>
          </div>
          <p class="mt-3 text-sm text-muted-foreground leading-relaxed max-w-2xl">
            The Aikami Hub is where creators will share worlds the way people share mods today — new
            maps, NPC rosters, item sets, entire campaigns. Self-hosters will be able to pull
            community packs straight into their own instance, no copy-paste, no file surgery.
          </p>
          <p class="mt-3 text-xs text-muted-foreground/70 leading-relaxed max-w-2xl">
            It's online, but barely built yet — expect an empty shell rather than a library. Worth a
            look if you want to see where it's going.
          </p>
        </div>
        <a
          href={hubUrl}
          class="inline-flex shrink-0 items-center gap-3 rounded-sm border border-border bg-card px-6 py-3.5 text-sm font-medium text-foreground transition-all hover:gap-4 hover:border-rune/50 no-underline"
        >
          Take an early look at the Hub
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </div>
</section>
