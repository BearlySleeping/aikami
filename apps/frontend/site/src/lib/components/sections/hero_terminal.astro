---
// apps/frontend/site/src/lib/components/sections/hero_terminal.astro
/**
 * "Ask the Dungeon Master" interactive mini-terminal.
 * Displays d20 roll outcomes from canvas and handles free-text action prompts.
 * Pure DOM component — no canvas needed.
 */
---

<section id="dm-terminal" class="mt-8 w-full max-w-lg" aria-label="Dungeon Master prompt terminal">
  <label
    for="dm-input"
    class="block font-mono text-[10px] uppercase tracking-widest text-rune mb-2"
  >
    Ask the Dungeon Master
  </label>
  <div class="glass-panel p-4 font-mono text-sm">
    <!-- Response area -->
    <div
      id="dm-response"
      class="min-h-[3.5rem] text-muted-foreground leading-relaxed mb-3 text-xs md:text-sm"
      aria-live="polite"
      aria-atomic="true"
    >
      <span class="text-rune">DM &gt;</span>&nbsp;
      <span id="dm-response-text">Speak thy intent, adventurer... or roll the d20 above.</span>
      <span id="dm-cursor" class="terminal-cursor"></span>
    </div>

    <!-- Roll result badge -->
    <div id="dm-roll-badge" class="hidden mb-3">
      <span
        id="dm-roll-number"
        class="inline-flex items-center gap-1.5 rounded-sm px-3 py-1 font-serif text-lg"
      ></span>
    </div>

    <!-- Input area -->
    <div class="flex items-center gap-2">
      <span class="text-rune shrink-0 text-xs">&gt;</span>
      <input
        id="dm-input"
        type="text"
        placeholder="I open the ancient tomb..."
        class="w-full bg-transparent border-none outline-none text-foreground placeholder:text-muted-foreground/50 font-mono text-xs md:text-sm py-1"
        autocomplete="off"
        aria-label="Enter your action prompt"
      >
      <button
        id="dm-submit"
        type="button"
        class="shrink-0 rounded-sm bg-rune px-3 py-1.5 text-xs font-medium text-white hover:opacity-90 transition-opacity"
        aria-label="Send prompt to Dungeon Master"
      >
        Roll
      </button>
    </div>
  </div>
</section>

<script>
// D20-based outcome responses — keyed by roll range
const d20Outcomes: Record<string, string[]> = {
  nat1: [
    '💀 NAT 1 — Critical Hazard! The floor crumbles beneath your feet. You plummet into darkness, the mocking laughter of goblins echoing above.',
    '💀 NAT 1 — Catastrophe! Your spell backfires spectacularly. The party stares at your soot-covered face in stunned silence.',
    '💀 NAT 1 — Disaster! You trip over an unseen root, alerting every creature within 300 feet. Roll for initiative with disadvantage.',
  ],
  low: [
    '⚡ Rolled low. You manage to pry the door open a crack, but the grinding stone alerts something in the shadows.',
    '⚡ A shaky attempt. The merchant eyes you suspiciously but says nothing. Yet.',
    '⚡ You stumble but catch yourself. The guard raises an eyebrow. "First time in a dungeon?"',
  ],
  mid: [
    '🎯 Solid roll. Your torch catches on the ancient sconces, illuminating faded murals of a long-dead king.',
    '🎯 Competent. The lock clicks open. Inside: a rusted key and a parchment that crumbles at your touch.',
    '🎯 Steady hands. You disarm the pressure plate just before your boot touches it. Close one.',
  ],
  high: [
    '✨ Great roll! You spot the hidden mechanism — a false wall slides open, revealing a forgotten armory.',
    "✨ Impressive. Your blade finds the gap in the creature's armor. It roars in pain and staggers backward.",
    '✨ With practiced precision, you decipher the runes. They speak of a treasure hidden beneath the old oak.',
  ],
  nat20: [
    '👑 NAT 20 — Divine Legendary! The gods themselves smile upon you. A radiant beam pierces the darkness, and an ancient dragon bows its head in reverence.',
    '👑 NAT 20 — Epic! Time seems to slow. You see every possible outcome and choose the perfect path. The impossible becomes trivial.',
    '👑 NAT 20 — Mythic! Your action echoes through the ages. Bards will sing of this moment for generations.',
  ],
};

// Free-text narrative responses
const narrativeResponses = [
  'The ancient stone doors grind open, revealing a chamber bathed in ethereal blue light. Runes along the walls pulse with dormant power.',
  'As your fingers touch the tomb\'s seal, a spectral guardian materializes. "Only the worthy may pass," it intones, eyes blazing.',
  'A gust of stale air escapes. Inside, sarcophagi line the walls. One lid lies cracked open — something has already been here.',
  'The mechanism clicks. From the darkness, a voice: "At last... someone who knows the old words." A figure steps into the torchlight.',
  'Trap! Poisoned darts fly from hidden nozzles. Roll a Dexterity saving throw...',
  'The tomb is empty — or so it seems. Your passive Perception catches a faint draft from a hidden passage behind the third sarcophagus.',
];

const responseEl = document.getElementById('dm-response-text');
const cursorEl = document.getElementById('dm-cursor');
const inputEl = document.getElementById('dm-input') as HTMLInputElement;
const submitBtn = document.getElementById('dm-submit');
const rollBadge = document.getElementById('dm-roll-badge');
const rollNumber = document.getElementById('dm-roll-number');

const getD20Outcome = (result: number, isNat1: boolean, isNat20: boolean): string => {
  const pick = (key: string): string => {
    const entries = d20Outcomes[key];
    if (!entries || entries.length === 0) {
      return 'The dice clatter across the table. Fate is uncertain.';
    }
    return (
      entries[Math.floor(Math.random() * entries.length)] ??
      'The dice clatter across the table. Fate is uncertain.'
    );
  };

  if (isNat1) {
    return pick('nat1');
  }
  if (isNat20) {
    return pick('nat20');
  }
  if (result <= 6) {
    return pick('low');
  }
  if (result <= 14) {
    return pick('mid');
  }
  return pick('high');
};

const typeResponse = async (text: string) => {
  if (!responseEl) {
    return;
  }

  responseEl.textContent = '';
  cursorEl?.classList.remove('terminal-cursor');

  for (let i = 0; i < text.length; i++) {
    responseEl.textContent += text[i];
    await new Promise((r) => setTimeout(r, 15 + Math.random() * 25));
  }

  cursorEl?.classList.add('terminal-cursor');
};

// Listen for d20 roll events from the PixiJS canvas
document.addEventListener('d20:roll', ((e: CustomEvent) => {
  const { result, isNat1, isNat20 } = e.detail;
  const outcome = getD20Outcome(result, isNat1, isNat20);

  // Show roll badge
  if (rollBadge && rollNumber) {
    const badgeColor = isNat1
      ? 'bg-destructive/20 text-destructive border border-destructive/40'
      : isNat20
        ? 'bg-amber-400/15 text-amber-400 border border-amber-400/40'
        : result >= 15
          ? 'bg-emerald-400/15 text-emerald-400 border border-emerald-400/40'
          : 'bg-rune/15 text-rune border border-rune/40';

    rollBadge.className = 'mb-3';
    rollNumber.className = `inline-flex items-center gap-1.5 rounded-sm px-3 py-1 font-serif text-lg ${badgeColor}`;
    rollNumber.textContent = `🎲 ${result}`;
  }

  typeResponse(outcome);
}) as EventListener);

const handleSubmit = () => {
  if (!inputEl) {
    return;
  }

  const prompt = inputEl.value.trim();

  // If empty, trigger d20 roll instead
  if (!prompt) {
    document.dispatchEvent(new CustomEvent('d20:trigger-roll'));
    return;
  }

  inputEl.value = '';

  // Hide roll badge
  if (rollBadge) {
    rollBadge.className = 'hidden mb-3';
  }

  const index = Math.floor(Math.random() * narrativeResponses.length);
  const response = narrativeResponses[index] ?? 'The darkness offers no reply.';
  typeResponse(response);
};

submitBtn?.addEventListener('click', handleSubmit);
inputEl?.addEventListener('keydown', (e: KeyboardEvent) => {
  if (e.key === 'Enter') {
    handleSubmit();
  }
});
</script>
