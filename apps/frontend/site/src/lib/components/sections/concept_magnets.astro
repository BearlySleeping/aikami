---
// apps/frontend/site/src/lib/components/sections/concept_magnets.astro
---

<section id="world-factions" class="border-b border-border/70 bg-card">
  <div class="mx-auto max-w-6xl px-6 py-24 md:py-28">
    <div class="max-w-2xl">
      <span class="eyebrow text-rune">World Simulation</span>
      <h2 class="mt-5 font-serif text-4xl md:text-5xl leading-tight">Factions that feel alive.</h2>
      <p class="mt-5 text-muted-foreground leading-relaxed">
        Drag and drop world factions across a semantic affinity space. Watch how the AI positions
        them based on their values — Nature vs. Arcane, Order vs. Chaos. Each faction has its own
        beliefs, alliances, and rivalries, all dynamically managed by the AI engine.
      </p>
    </div>

    <div class="mt-10 rune-border overflow-hidden bg-background/50">
      <div
        id="concept-magnets-canvas"
        class="w-full h-[420px] md:h-[480px] relative"
        role="img"
        aria-label="Interactive faction affinity space with draggable concept magnets"
      ></div>
    </div>

    <p class="mt-4 text-xs text-muted-foreground/60">
      Drag any faction orb to explore semantic relationships. Release to watch it glide toward its
      natural affinity position.
    </p>
  </div>
</section>

<script>
/** Defer PixiJS init until section scrolls into view. */
const magnetsEl = document.getElementById('concept-magnets-canvas');
let cleanup: (() => void) | undefined;
let observer: IntersectionObserver | undefined;
let disposed = false;

if (magnetsEl) {
  observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          observer?.disconnect();
          import('./concept_magnets_canvas')
            .then(async ({ initConceptMagnets }) => {
              if (disposed) {
                return;
              }
              const cleanupFn = await initConceptMagnets('concept-magnets-canvas');
              if (disposed) {
                cleanupFn();
              } else {
                cleanup = cleanupFn;
              }
            })
            .catch(() => {
              /* noop — canvas is optional for SEO */
            });
        }
      }
    },
    { rootMargin: '200px' },
  );
  observer.observe(magnetsEl);
}

document.addEventListener('astro:before-swap', () => {
  disposed = true;
  observer?.disconnect();
  cleanup?.();
});
</script>
