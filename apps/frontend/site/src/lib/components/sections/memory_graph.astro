---
// apps/frontend/site/src/lib/components/sections/memory_graph.astro
---

<section id="ai-cognition" class="border-b border-border/70 bg-card">
  <div class="mx-auto max-w-6xl px-6 py-24 md:py-28">
    <div class="max-w-2xl">
      <span class="eyebrow text-rune">AI Cognition Engine</span>
      <h2 class="mt-5 font-serif text-4xl md:text-5xl leading-tight">
        Every NPC thinks, remembers, and adapts.
      </h2>
      <p class="mt-5 text-muted-foreground leading-relaxed">
        Aikami's AI engine maintains dual-track memory for every agent: a fast, volatile short-term
        buffer for immediate context, and a persistent long-term world state that evolves with every
        interaction.
      </p>
    </div>

    <!-- Interactive graph -->
    <div class="mt-10 rune-border overflow-hidden bg-background/50">
      <div
        id="memory-graph-canvas"
        class="w-full h-[380px] md:h-[440px] relative"
        role="img"
        aria-label="Interactive AI memory graph showing short-term and long-term memory nodes"
      ></div>
    </div>

    <div class="mt-6 grid grid-cols-2 gap-4 text-xs md:text-sm">
      <div class="glass-panel p-4 flex items-start gap-3">
        <span class="h-2.5 w-2.5 rounded-full bg-indigo-400 mt-1 shrink-0" aria-hidden></span>
        <div>
          <span class="font-mono text-[10px] uppercase tracking-wider text-indigo-400 font-medium"
            >Short-Term Memory</span
          >
          <p class="mt-1 text-muted-foreground leading-relaxed">
            Volatile context buffer — recent dialog, active quests, combat state. Resets on session
            end.
          </p>
        </div>
      </div>
      <div class="glass-panel p-4 flex items-start gap-3">
        <span class="h-2.5 w-2.5 rounded-full bg-purple-400 mt-1 shrink-0" aria-hidden></span>
        <div>
          <span class="font-mono text-[10px] uppercase tracking-wider text-purple-400 font-medium"
            >Long-Term World State</span
          >
          <p class="mt-1 text-muted-foreground leading-relaxed">
            Persistent knowledge — world lore, faction relations, player choices. Survives across
            sessions.
          </p>
        </div>
      </div>
    </div>

    <p class="mt-3 text-xs text-muted-foreground/60">
      Click any node to inspect the agent's current state.
    </p>
  </div>
</section>

<script>
/** Defer PixiJS init until section scrolls into view. */
const memoryEl = document.getElementById('memory-graph-canvas');
let cleanup: (() => void) | undefined;
let observer: IntersectionObserver | undefined;
let disposed = false;

if (memoryEl) {
  observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          observer?.disconnect();
          import('./memory_graph_canvas')
            .then(async ({ initMemoryGraph }) => {
              if (disposed) {
                return;
              }
              const cleanupFn = await initMemoryGraph('memory-graph-canvas');
              if (disposed) {
                cleanupFn();
              } else {
                cleanup = cleanupFn;
              }
            })
            .catch(() => {
              // Canvas initialization failed — no fallback needed
            });
        }
      }
    },
    { rootMargin: '200px' },
  );
  observer.observe(memoryEl);
}

document.addEventListener('astro:before-swap', () => {
  disposed = true;
  observer?.disconnect();
  cleanup?.();
});
</script>
