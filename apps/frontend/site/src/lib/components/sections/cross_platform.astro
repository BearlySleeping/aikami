---
// apps/frontend/site/src/lib/components/sections/cross_platform.astro
/**
 * Cross-Platform Architecture — Web Client + Tauri Desktop.
 * Demonstrates real-time sync across platforms and auto-generated LPC character visuals.
 */
---

<section id="cross-platform" class="border-b border-border/70 bg-card">
  <div class="mx-auto max-w-6xl px-6 py-24 md:py-28">
    <div class="max-w-2xl">
      <span class="eyebrow text-emerald-400">Engine Architecture</span>
      <h2 class="mt-5 font-serif text-4xl md:text-5xl leading-tight">
        From browser to native desktop. Same world, same NPCs.
      </h2>
      <p class="mt-5 text-muted-foreground leading-relaxed">
        One world, every platform. The same world state streams in real time across the Web Client
        and the Tauri v2 desktop app — play in your browser, pick up on your desktop, same NPCs,
        same story. Saves live on your own machine first, with optional cloud sync for multi-device
        play. And every character is rendered from dynamically assembled LPC (Liberated Pixel Cup)
        sprite layers, so each NPC looks as unique as their story.
      </p>
    </div>

    <!-- Device Frames -->
    <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-8 max-w-2xl mx-auto">
      <!-- Web Client -->
      <div class="text-center group">
        <div
          class="rune-border p-6 bg-background/50 mb-4 transition-transform group-hover:-translate-y-1"
        >
          <div class="flex items-center justify-center mb-4">
            <svg
              width="40"
              height="40"
              viewBox="0 0 24 24"
              fill="none"
              stroke="var(--rune)"
              stroke-width="1.2"
              aria-hidden="true"
            >
              <rect x="2" y="3" width="20" height="14" rx="2" />
              <path d="M8 21h8M12 17v4" />
            </svg>
          </div>
          <p class="font-mono text-[10px] uppercase tracking-widest text-rune mb-2">Web Client</p>
          <p class="font-serif text-xl text-foreground mb-1">Svelte 5 + PixiJS v8</p>
          <p class="text-xs text-muted-foreground leading-relaxed">
            Play instantly in any modern browser. Full 2D rendering with WebGL, WebSocket sync, and
            offline PWA support. Auto-generated LPC character sprites rendered in real-time.
          </p>
          <div class="mt-4 flex justify-center gap-2">
            <span
              class="rounded-full bg-rune/10 border border-rune/20 px-2 py-0.5 text-[9px] font-mono text-rune"
              >WebGL 2</span
            >
            <span
              class="rounded-full bg-rune/10 border border-rune/20 px-2 py-0.5 text-[9px] font-mono text-rune"
              >PWA</span
            >
          </div>
        </div>
      </div>

      <!-- Tauri Desktop -->
      <div class="text-center group">
        <div
          class="rune-border p-6 bg-background/50 mb-4 transition-transform group-hover:-translate-y-1"
        >
          <div class="flex items-center justify-center mb-4">
            <svg
              width="40"
              height="40"
              viewBox="0 0 24 24"
              fill="none"
              stroke="var(--ember)"
              stroke-width="1.2"
              aria-hidden="true"
            >
              <rect x="2" y="3" width="20" height="14" rx="2" />
              <path d="M8 21h8M12 17v4" />
              <path d="M6 7h12M6 10h12M6 13h8" />
            </svg>
          </div>
          <p class="font-mono text-[10px] uppercase tracking-widest text-ember mb-2">Desktop</p>
          <p class="font-serif text-xl text-foreground mb-1">Tauri v2</p>
          <p class="text-xs text-muted-foreground leading-relaxed">
            Native desktop experience with Rust-powered performance. File system access, system
            tray, and multi-window support across Windows, macOS, and Linux.
          </p>
          <div class="mt-4 flex justify-center gap-2">
            <span
              class="rounded-full bg-ember/10 border border-ember/20 px-2 py-0.5 text-[9px] font-mono text-ember"
              >Rust</span
            >
            <span
              class="rounded-full bg-ember/10 border border-ember/20 px-2 py-0.5 text-[9px] font-mono text-ember"
              >Native</span
            >
          </div>
        </div>
      </div>
    </div>

    <!-- LPC Character Generation Callout -->
    <div class="mt-10 rune-border p-8 bg-background/50 max-w-2xl mx-auto">
      <div class="text-center">
        <span class="font-mono text-[10px] uppercase tracking-widest text-rune mb-3 block">
          Procedural Character Rendering
        </span>
        <p class="text-sm text-muted-foreground leading-relaxed mb-4">
          Aikami dynamically generates every NPC's visual appearance using the LPC (Liberated Pixel
          Cup) sprite system. Each character is assembled from modular layers — head, body, hair,
          torso, legs, and feet — chosen to match the NPC's generated archetype, faction, and
          backstory. Expression packs auto-update based on conversation context (happy, sad, angry,
          surprised) and situational scene images are generated on demand by the AI pipeline.
          Background music shifts with mood. NPCs speak with unique AI-generated voices. ComfyUI and
          Kokoro TTS run locally by default, but you can swap in any supported provider —
          ElevenLabs, Stability AI, DALL·E, and more. No static sprite sheets. Every character is
          unique.
        </p>
        <div class="flex flex-wrap justify-center gap-2">
          <span
            class="rounded-full bg-rune/10 border border-rune/20 px-2.5 py-1 text-[10px] font-mono text-rune"
            >LPC Sprites</span
          >
          <span
            class="rounded-full bg-ember/10 border border-ember/20 px-2.5 py-1 text-[10px] font-mono text-ember"
            >Procedural Assembly</span
          >
          <span
            class="rounded-full bg-indigo-400/10 border border-indigo-400/20 px-2.5 py-1 text-[10px] font-mono text-indigo-400"
            >Modular Layers</span
          >
        </div>
      </div>
    </div>

    <!-- Real-time sync diagram -->
    <div class="mt-10 rune-border p-8 bg-background/50">
      <div class="flex flex-col md:flex-row items-center justify-center gap-4 md:gap-8">
        <div class="glass-panel px-5 py-3 text-center">
          <span class="font-mono text-[10px] uppercase tracking-widest text-muted-foreground"
            >Client Action</span
          >
          <p class="text-sm text-foreground mt-1">Player moves, dialogue, combat</p>
        </div>
        <span class="text-rune text-xl hidden md:block" aria-hidden="true">→</span>
        <span class="text-rune text-xl md:hidden" aria-hidden="true">↓</span>
        <div class="glass-panel px-5 py-3 text-center border-rune">
          <span class="font-mono text-[10px] uppercase tracking-widest text-rune"
            >Firebase Realtime</span
          >
          <p class="text-sm text-foreground mt-1">State sync layer</p>
        </div>
        <span class="text-rune text-xl hidden md:block" aria-hidden="true">→</span>
        <span class="text-rune text-xl md:hidden" aria-hidden="true">↓</span>
        <div class="flex flex-wrap gap-4 justify-center">
          <div class="glass-panel px-5 py-3 text-center">
            <span class="font-mono text-[10px] uppercase tracking-widest text-muted-foreground"
              >Web Client</span
            >
            <p class="text-sm text-rune mt-1">Svelte 5</p>
          </div>
          <div class="glass-panel px-5 py-3 text-center">
            <span class="font-mono text-[10px] uppercase tracking-widest text-muted-foreground"
              >Desktop</span
            >
            <p class="text-sm text-ember mt-1">Tauri v2</p>
          </div>
        </div>
      </div>
      <p class="text-center text-xs text-muted-foreground/60 mt-6">
        All clients share a single world state. Play on web, continue on desktop — same world, same
        NPCs.
      </p>
    </div>

    <!-- Tech Badges -->
    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <span
        class="rounded-sm bg-rune/10 border border-rune/20 px-4 py-2 text-xs font-mono text-rune"
        >TypeScript</span
      >
      <span
        class="rounded-sm bg-ember/10 border border-ember/20 px-4 py-2 text-xs font-mono text-ember"
        >Tauri v2</span
      >
      <span
        class="rounded-sm bg-cyan-400/10 border border-cyan-400/20 px-4 py-2 text-xs font-mono text-cyan-400"
        >Turso / libSQL</span
      >
      <span
        class="rounded-sm bg-emerald-400/10 border border-emerald-400/20 px-4 py-2 text-xs font-mono text-emerald-400"
        >bitECS</span
      >
      <span
        class="rounded-sm bg-purple-400/10 border border-purple-400/20 px-4 py-2 text-xs font-mono text-purple-400"
        >LPC Sprites</span
      >
      <span
        class="rounded-sm bg-indigo-400/10 border border-indigo-400/20 px-4 py-2 text-xs font-mono text-indigo-400"
        >Firebase (optional)</span
      >
    </div>
  </div>
</section>
