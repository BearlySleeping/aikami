---
// apps/frontend/site/src/lib/components/sections/living_world.astro
/**
 * "A living world" — compact showcase grid for the systems that don't get
 * their own full section: equipment-driven LPC re-rendering, expression
 * portraits, the Music DJ, on-demand scene art, world generation, and
 * inventory/vendors. One card each, no new canvas/JS — keeps the page fast.
 */

type Card = {
  title: string;
  body: string;
  color: 'rune' | 'ember' | 'indigo' | 'emerald' | 'cyan' | 'rose';
  icon: 'equipment' | 'expression' | 'music' | 'image' | 'world' | 'inventory';
};

const cards: Card[] = [
  {
    title: 'Gear that redraws your character',
    body: 'Equip a weapon or a piece of armor and the LPC sprite updates layer-by-layer, live, on the spot — no reload, no swapping to a menu screen.',
    color: 'rune',
    icon: 'equipment',
  },
  {
    title: 'Expressions that read the scene',
    body: "Portraits swap automatically based on what's happening in the AI's narration, with a keyword fallback so a threatened NPC still looks the part.",
    color: 'ember',
    icon: 'expression',
  },
  {
    title: 'A soundtrack that follows the story',
    body: 'The Music DJ agent reads location, weather, combat state, and mood from each response and crossfades to a matching track — no manual playlist.',
    color: 'indigo',
    icon: 'music',
  },
  {
    title: 'Scene art on demand',
    body: 'Situational illustrations generated by your configured image provider — sd-server locally by default, or DALL·E, Stability AI, NovelAI, and more via BYOK.',
    color: 'cyan',
    icon: 'image',
  },
  {
    title: 'A world generated, not scripted',
    body: 'NPCs, locations, and party arcs are seeded procedurally at campaign start, so no two playthroughs open in the same place with the same people.',
    color: 'emerald',
    icon: 'world',
  },
  {
    title: 'Real inventory and vendors',
    body: 'Loot, trade, and equip gear that actually changes how your character looks and fights — the paperdoll above is what you carry, not a cosmetic.',
    color: 'rose',
    icon: 'inventory',
  },
];

const colorClasses: Record<Card['color'], { text: string; border: string; bg: string }> = {
  rune: { text: 'text-rune', border: 'border-rune/20', bg: 'bg-rune/5' },
  ember: { text: 'text-ember', border: 'border-ember/20', bg: 'bg-ember/5' },
  indigo: { text: 'text-indigo-400', border: 'border-indigo-400/20', bg: 'bg-indigo-400/5' },
  emerald: { text: 'text-emerald-400', border: 'border-emerald-400/20', bg: 'bg-emerald-400/5' },
  cyan: { text: 'text-cyan-400', border: 'border-cyan-400/20', bg: 'bg-cyan-400/5' },
  rose: { text: 'text-rose-400', border: 'border-rose-400/20', bg: 'bg-rose-400/5' },
};
---

<section id="living-world" class="border-b border-border/70 bg-card">
  <div class="mx-auto max-w-6xl px-6 py-24 md:py-28">
    <div class="max-w-2xl">
      <span class="eyebrow text-rune">A living world</span>
      <h2 class="mt-5 font-serif text-4xl md:text-5xl leading-tight">
        The world reacts. In more ways than you'd expect.
      </h2>
      <p class="mt-5 text-muted-foreground leading-relaxed">
        Memory and the AI Game Master are the core loop — but the systems around them are what make
        Aikami feel alive rather than scripted. A sample of what's running under the hood.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {cards.map((card) => (
        <div
          class={`glass-panel p-6 border ${colorClasses[card.color].border} hover:-translate-y-0.5 transition-transform`}
        >
          <span
            class={`flex h-10 w-10 items-center justify-center rounded-sm border ${colorClasses[card.color].border} ${colorClasses[card.color].bg} ${colorClasses[card.color].text} mb-4`}
            aria-hidden="true"
          >
            {card.icon === 'equipment' && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M12 2l7 3v6c0 5-3 8.5-7 11-4-2.5-7-6-7-11V5l7-3z" />
                <path d="M9 12l2 2 4-4" />
              </svg>
            )}
            {card.icon === 'expression' && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="M9 10h.01M15 10h.01" stroke-linecap="round" />
                <path d="M8.5 15c1 1 2.2 1.5 3.5 1.5s2.5-.5 3.5-1.5" stroke-linecap="round" />
              </svg>
            )}
            {card.icon === 'music' && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M9 18V5l11-2v13" />
                <circle cx="6" cy="18" r="3" />
                <circle cx="17" cy="16" r="3" />
              </svg>
            )}
            {card.icon === 'image' && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="2" />
                <circle cx="8.5" cy="8.5" r="1.5" />
                <path d="M21 15l-5-5-9 9" />
              </svg>
            )}
            {card.icon === 'world' && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="M3 12h18M12 3c2.5 2.5 4 5.7 4 9s-1.5 6.5-4 9c-2.5-2.5-4-5.7-4-9s1.5-6.5 4-9z" />
              </svg>
            )}
            {card.icon === 'inventory' && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M4 8l8-5 8 5v9l-8 5-8-5V8z" />
                <path d="M4 8l8 5 8-5M12 13v8" />
              </svg>
            )}
          </span>
          <h3 class="font-serif text-xl leading-tight">{card.title}</h3>
          <p class="mt-2.5 text-sm text-muted-foreground leading-relaxed">{card.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
