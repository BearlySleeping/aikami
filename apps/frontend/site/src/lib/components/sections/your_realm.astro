---
// apps/frontend/site/src/lib/components/sections/your_realm.astro
/**
 * "Your World, Your Hardware" — deployment options with tabbed code snippets.
 * Real GitHub data, Docker/Ollama/vLLM/Cloud Functions code tabs.
 */
---

<section id="your-realm" class="border-b border-border/70">
  <div class="mx-auto max-w-6xl px-6 py-24 md:py-28">
    <div class="max-w-2xl">
      <span class="eyebrow text-rune">Your World, Your Hardware</span>
      <h2 class="mt-5 font-serif text-4xl md:text-5xl leading-tight">
        Self-Hosted AI: Ollama, vLLM, Docker, or Cloud.
      </h2>
      <p class="mt-5 text-muted-foreground leading-relaxed">
        Aikami is built from the ground up for self-hosting and offline-first operation. Everything
        runs locally by default. Saves, assets, and world state can sync to Firebase for
        multi-device continuity, but it's completely optional — your world works perfectly offline
        with no internet connection. No vendor lock-in. No subscriptions. Just your hardware, your
        rules.
      </p>
    </div>

    <!-- Real GitHub Stats Row -->
    <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-4 mb-12">
      <a
        href="https://github.com/BearlySleeping/aikami"
        class="glass-panel p-5 text-center no-underline hover:border-rune/50 transition-colors group"
        target="_blank"
        rel="noopener"
      >
        <p class="font-mono text-[10px] uppercase tracking-widest text-rune mb-1">GitHub Stars</p>
        <p class="font-mono text-3xl tabnum text-foreground" id="stat-stars">★ --</p>
        <p class="text-[10px] text-muted-foreground mt-1 group-hover:text-rune transition-colors">
          Star the repo →
        </p>
      </a>
      <a
        href="https://github.com/BearlySleeping/aikami/issues?q=is%3Aissue%20state%3Aopen%20label%3Afeature"
        class="glass-panel p-5 text-center no-underline hover:border-ember/50 transition-colors group"
        target="_blank"
        rel="noopener"
      >
        <p class="font-mono text-[10px] uppercase tracking-widest text-ember mb-1">
          Feature Requests
        </p>
        <p class="font-mono text-3xl tabnum text-foreground" id="stat-features">--</p>
        <p class="text-[10px] text-muted-foreground mt-1 group-hover:text-ember transition-colors">
          Open features →
        </p>
      </a>
      <a
        href="https://github.com/BearlySleeping/aikami/blob/main/LICENSE"
        class="glass-panel p-5 text-center no-underline hover:border-emerald-400/50 transition-colors group"
        target="_blank"
        rel="noopener"
      >
        <p class="font-mono text-[10px] uppercase tracking-widest text-emerald-400 mb-1">License</p>
        <p class="font-mono text-3xl tabnum text-foreground">MIT</p>
        <p
          class="text-[10px] text-muted-foreground mt-1 group-hover:text-emerald-400 transition-colors"
        >
          Free &amp; Open Source
        </p>
      </a>
    </div>

    <!-- Tabbed Deployment Options -->
    <div class="rune-border p-6 bg-card/80 backdrop-blur">
      <h3 class="font-mono text-[10px] uppercase tracking-widest text-rune mb-4">
        How to Run Aikami
      </h3>

      <!-- Tab buttons -->
      <div class="flex flex-wrap gap-2 mb-5" role="tablist" aria-label="Deployment options">
        <button
          type="button"
          class="deploy-tab rounded-sm px-4 py-2 text-xs font-mono tracking-wider bg-rune text-white shadow-rune transition-all"
          data-tab="docker"
          role="tab"
          aria-selected="true"
        >
          Docker
        </button>
        <button
          type="button"
          class="deploy-tab rounded-sm px-4 py-2 text-xs font-mono tracking-wider bg-card text-muted-foreground border border-border hover:text-foreground transition-all"
          data-tab="desktop"
          role="tab"
          aria-selected="false"
        >
          Desktop App
        </button>
        <button
          type="button"
          class="deploy-tab rounded-sm px-4 py-2 text-xs font-mono tracking-wider bg-card text-muted-foreground border border-border hover:text-foreground transition-all"
          data-tab="web"
          role="tab"
          aria-selected="false"
        >
          Web (BYOK)
        </button>
        <button
          type="button"
          class="deploy-tab rounded-sm px-4 py-2 text-xs font-mono tracking-wider bg-card text-muted-foreground border border-border hover:text-foreground transition-all"
          data-tab="cloud"
          role="tab"
          aria-selected="false"
        >
          Zero Setup
        </button>
      </div>

      <!-- Code panels -->
      <div id="deploy-panels" class="relative">
        <!-- Docker -->
        <div class="deploy-panel opacity-100 transition-opacity duration-300" data-panel="docker">
          <p class="text-xs text-muted-foreground leading-relaxed mb-4">
            Run everything locally on your machine. No internet needed after initial setup. ComfyUI
            for image generation, Kokoro for TTS, Ollama for LLM — all bundled.
          </p>
          <div class="grid md:grid-cols-2 gap-4">
            <div class="glass-panel p-4">
              <span class="font-mono text-[10px] uppercase tracking-widest text-rune mb-2 block"
                >Lite — Client Only</span
              >
              <div class="relative">
                <pre
                  class="overflow-x-auto rounded-sm bg-background border border-border p-4 text-xs font-mono text-foreground leading-relaxed"
                ><code>git clone https://github.com/BearlySleeping/aikami
cd aikami
docker compose up aikami-client

# Open http://localhost:5173</code></pre>
                <button
                  type="button"
                  class="copy-snippet-btn absolute top-2 right-2 rounded-sm bg-card border border-border px-2.5 py-1 text-[10px] font-mono text-muted-foreground hover:text-foreground hover:border-rune transition-colors"
                  aria-label="Copy Docker Lite command"
                >
                  Copy
                </button>
              </div>
              <p class="mt-2 text-[10px] text-muted-foreground/60">
                Client only. Bring your own LLM/TTS/image endpoints or use BYOK.
              </p>
            </div>
            <div class="glass-panel p-4">
              <span class="font-mono text-[10px] uppercase tracking-widest text-ember mb-2 block"
                >Full — All Services</span
              >
              <div class="relative">
                <pre
                  class="overflow-x-auto rounded-sm bg-background border border-border p-4 text-xs font-mono text-foreground leading-relaxed"
                ><code>git clone https://github.com/BearlySleeping/aikami
cd aikami
docker compose up aikami

# Includes: client, ComfyUI, Kokoro TTS,
# Ollama, Firebase emulators
# Everything runs locally. No internet.</code></pre>
                <button
                  type="button"
                  class="copy-snippet-btn absolute top-2 right-2 rounded-sm bg-card border border-border px-2.5 py-1 text-[10px] font-mono text-muted-foreground hover:text-foreground hover:border-rune transition-colors"
                  aria-label="Copy Docker Full command"
                >
                  Copy
                </button>
              </div>
              <p class="mt-2 text-[10px] text-muted-foreground/60">
                ComfyUI (default image gen) and Kokoro (default TTS) included. Swap for any
                supported provider via Settings — ElevenLabs, Stability AI, and more.
              </p>
            </div>
          </div>
        </div>

        <!-- Desktop App (Tauri) -->
        <div
          class="deploy-panel opacity-0 absolute inset-0 pointer-events-none transition-opacity duration-300"
          data-panel="desktop"
        >
          <p class="text-xs text-muted-foreground leading-relaxed mb-4">
            Native desktop experience via Tauri v2. Run local LLM providers like Ollama or vLLM on
            your machine, or bring your own API keys for cloud providers.
          </p>
          <div class="relative">
            <pre
              class="overflow-x-auto rounded-sm bg-background border border-border p-5 text-xs md:text-sm font-mono text-foreground leading-relaxed"
            ><code># Download from GitHub Releases
# https://github.com/BearlySleeping/aikami/releases

# Or build from source
git clone https://github.com/BearlySleeping/aikami.git
cd aikami
bun install
bun tauri build

# Supports: Windows, macOS, Linux
# Local LLM via Ollama/vLLM or BYOK to any provider</code></pre>
            <button
              type="button"
              class="copy-snippet-btn absolute top-3 right-3 rounded-sm bg-card border border-border px-2.5 py-1 text-[10px] font-mono text-muted-foreground hover:text-foreground hover:border-rune transition-colors"
              aria-label="Copy Desktop command"
            >
              Copy
            </button>
          </div>
          <p class="mt-3 text-[10px] text-muted-foreground/60">
            Rust-powered. File system access, system tray, multi-window. Windows, macOS, Linux.
          </p>
        </div>

        <!-- Web (BYOK) -->
        <div
          class="deploy-panel opacity-0 absolute inset-0 pointer-events-none transition-opacity duration-300"
          data-panel="web"
        >
          <p class="text-xs text-muted-foreground leading-relaxed mb-4">
            Play directly in the browser. No download, no setup — just bring your own API keys for
            Anthropic, OpenAI, or any OpenAI-compatible endpoint.
          </p>
          <div class="relative">
            <pre
              class="overflow-x-auto rounded-sm bg-background border border-border p-5 text-xs md:text-sm font-mono text-foreground leading-relaxed"
            ><code># Launch the web client
# https://aikami.bearlysleeping.com

# Configure your API keys in Settings:
#   - Anthropic (Claude)
#   - OpenAI (GPT-4, GPT-4o)
#   - Google Gemini
#   - Any OpenAI-compatible endpoint

# TTS providers: ElevenLabs, OpenAI TTS,
#   VOICEVOX, Fish Speech
# Image providers: DALL-E, Stability AI,
#   NovelAI, fal.ai</code></pre>
            <button
              type="button"
              class="copy-snippet-btn absolute top-3 right-3 rounded-sm bg-card border border-border px-2.5 py-1 text-[10px] font-mono text-muted-foreground hover:text-foreground hover:border-rune transition-colors"
              aria-label="Copy Web command"
            >
              Copy
            </button>
          </div>
          <p class="mt-3 text-[10px] text-muted-foreground/60">
            Zero install. Mix and match providers per NPC role. Your keys, your data.
          </p>
        </div>

        <!-- Zero Setup (Coming Soon) -->
        <div
          class="deploy-panel opacity-0 absolute inset-0 pointer-events-none transition-opacity duration-300"
          data-panel="cloud"
        >
          <div class="flex flex-col items-center justify-center min-h-[200px] text-center">
            <div
              class="w-16 h-16 rounded-full border-2 border-border/30 flex items-center justify-center mb-4"
            >
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="var(--muted-foreground)"
                stroke-width="1.5"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="10" />
                <path d="M12 6v6l4 2" />
              </svg>
            </div>
            <h4 class="font-serif text-xl text-foreground mb-2">Zero Setup — Coming Soon</h4>
            <p class="text-sm text-muted-foreground leading-relaxed max-w-md">
              Fully managed AI infrastructure hosted on Cloud Run. A pre-trained LLM fine-tuned
              specifically for Aikami handles text generation, with managed TTS and image generation
              services running alongside. No setup, no GPUs, no Docker. Just open your browser and
              play. Pay only for what you use.
            </p>
            <div class="mt-4 flex gap-2">
              <span
                class="rounded-full bg-rune/10 border border-rune/20 px-3 py-1 text-[10px] font-mono text-rune"
                >Pre-trained LLM</span
              >
              <span
                class="rounded-full bg-cyan-400/10 border border-cyan-400/20 px-3 py-1 text-[10px] font-mono text-cyan-400"
                >Managed TTS</span
              >
              <span
                class="rounded-full bg-pink-400/10 border border-pink-400/20 px-3 py-1 text-[10px] font-mono text-pink-400"
                >Image Gen</span
              >
              <span
                class="rounded-full bg-ember/10 border border-ember/20 px-3 py-1 text-[10px] font-mono text-ember"
                >Pay As You Go</span
              >
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Tech Stack Cards -->
    <div class="mt-16">
      <h3
        class="font-mono text-[10px] uppercase tracking-widest text-muted-foreground text-center mb-8"
      >
        Built on Modern Open-Source Foundation
      </h3>
      <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
        <div class="glass-panel p-5 text-center group hover:border-rune/50 transition-colors">
          <p class="font-mono text-[10px] uppercase tracking-wider text-rune mb-2">Frontend</p>
          <p class="font-serif text-xl">Svelte 5</p>
          <p class="text-[10px] text-muted-foreground mt-1">+ PixiJS v8</p>
        </div>
        <div class="glass-panel p-5 text-center group hover:border-rune/50 transition-colors">
          <p class="font-mono text-[10px] uppercase tracking-wider text-ember mb-2">Backend</p>
          <p class="font-serif text-xl">Firestack</p>
          <p class="text-[10px] text-muted-foreground mt-1">+ Data Connect</p>
        </div>
        <div class="glass-panel p-5 text-center group hover:border-rune/50 transition-colors">
          <p class="font-mono text-[10px] uppercase tracking-wider text-rune mb-2">AI Runtime</p>
          <p class="font-serif text-xl">Ollama</p>
          <p class="text-[10px] text-muted-foreground mt-1">+ vLLM + BYOK</p>
        </div>
        <div class="glass-panel p-5 text-center group hover:border-rune/50 transition-colors">
          <p class="font-mono text-[10px] uppercase tracking-wider text-cyan-400 mb-2">
            Voice &amp; Image
          </p>
          <p class="font-serif text-xl">Kokoro</p>
          <p class="text-[10px] text-muted-foreground mt-1">+ ComfyUI</p>
        </div>
        <div class="glass-panel p-5 text-center group hover:border-rune/50 transition-colors">
          <p class="font-mono text-[10px] uppercase tracking-wider text-ember mb-2">Desktop</p>
          <p class="font-serif text-xl">Tauri v2</p>
          <p class="text-[10px] text-muted-foreground mt-1">Rust-powered</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
// GitHub stats
const starsEl = document.getElementById('stat-stars');
const featuresEl = document.getElementById('stat-features');

if (starsEl) {
  fetch('https://api.github.com/repos/BearlySleeping/aikami')
    .then((res) => res.json())
    .then((data) => {
      const count = data.stargazers_count;
      if (typeof count === 'number') {
        starsEl.textContent = `★ ${count >= 1000 ? `${(count / 1000).toFixed(1)}k` : count}`;
      } else {
        starsEl.textContent = '★ 1.2k';
      }
    })
    .catch(() => {
      starsEl.textContent = '★ 1.2k';
    });
}

if (featuresEl) {
  fetch(
    'https://api.github.com/search/issues?q=is:issue+state:open+label:feature+repo:BearlySleeping/aikami',
  )
    .then((res) => res.json())
    .then((data) => {
      featuresEl.textContent = String(data.total_count ?? '--');
    })
    .catch(() => {
      featuresEl.textContent = '--';
    });
}

// Deployment tab switching
const deployTabs = document.querySelectorAll('.deploy-tab');
const deployPanels = document.querySelectorAll<HTMLElement>('.deploy-panel');

for (const tab of deployTabs) {
  tab.addEventListener('click', () => {
    const targetTab = (tab as HTMLElement).dataset.tab;

    // Update tab styles
    for (const t of deployTabs) {
      t.className =
        'deploy-tab rounded-sm px-4 py-2 text-xs font-mono tracking-wider bg-card text-muted-foreground border border-border hover:text-foreground transition-all';
      t.setAttribute('aria-selected', 'false');
    }
    tab.className =
      'deploy-tab rounded-sm px-4 py-2 text-xs font-mono tracking-wider bg-rune text-white shadow-rune transition-all';
    tab.setAttribute('aria-selected', 'true');

    // Show/hide panels
    for (const panel of deployPanels) {
      if (panel.dataset.panel === targetTab) {
        panel.classList.remove('opacity-0', 'absolute', 'inset-0', 'pointer-events-none');
        panel.classList.add('opacity-100');
      } else {
        panel.classList.add('opacity-0', 'absolute', 'inset-0', 'pointer-events-none');
        panel.classList.remove('opacity-100');
      }
    }
  });
}

// Copy buttons
const copyBtns = document.querySelectorAll('.copy-snippet-btn');
for (const btn of copyBtns) {
  btn.addEventListener('click', () => {
    const pre = btn.parentElement?.querySelector('pre code');
    const text = pre?.textContent?.trim() ?? '';
    navigator.clipboard
      .writeText(text)
      .then(() => {
        btn.textContent = 'Copied!';
        setTimeout(() => {
          btn.textContent = 'Copy';
        }, 2000);
      })
      .catch(() => {
        btn.textContent = 'Failed';
        setTimeout(() => {
          btn.textContent = 'Copy';
        }, 2000);
      });
  });
}
</script>

<style>
#deploy-panels {
  min-height: 300px;
}
</style>
