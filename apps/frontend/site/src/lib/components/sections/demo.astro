---
// apps/frontend/site/src/lib/components/sections/demo.astro
import Button from '$components/common/button.astro';
---

<section id="demo" class="border-b border-border/70 bg-card">
  <div class="mx-auto max-w-6xl px-6 py-24 md:py-28">
    <div class="max-w-2xl">
      <span class="eyebrow">Try it out</span>
      <h2 class="mt-5 font-serif text-4xl md:text-5xl leading-tight">
        Play Aikami on your platform.
      </h2>
      <p class="mt-5 text-muted-foreground leading-relaxed">
        Download the desktop client or play directly in your browser. Cross-platform support for
        Windows, Linux, and macOS via Tauri.
      </p>
    </div>
    <div class="mt-10 flex flex-wrap gap-4">
      <Button
        href="https://github.com/BearlySleeping/aikami/releases"
        label="Download for Windows"
        variant="primary"
      />
      <Button
        href="https://github.com/BearlySleeping/aikami/releases"
        label="Download for Linux"
        variant="secondary"
      />
      <Button
        href="https://github.com/BearlySleeping/aikami/releases"
        label="Download for macOS"
        variant="secondary"
      />
    </div>
  </div>
</section>
