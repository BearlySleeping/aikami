---
// apps/frontend/site/src/lib/components/sections/adventurers_guild.astro
/**
 * Adventurer & Developer Guildhall — open-source launchpad.
 * Star on GitHub, Quickstart Guide, Discord invite, copyable terminal snippet,
 * and live animated telemetry tickers.
 */
---

<section id="adventurers-guild" class="relative overflow-hidden border-b border-border/70">
  <div class="grain absolute inset-0 opacity-60 z-[1] pointer-events-none" aria-hidden></div>

  <div class="mx-auto max-w-6xl px-6 py-24 md:py-28 relative z-10">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="eyebrow text-ember">Open Source Guildhall</span>
      <h2 class="mt-5 font-serif text-4xl md:text-5xl leading-tight">
        Join the guild. Build the realm.
      </h2>
      <p class="mt-5 text-muted-foreground leading-relaxed">
        Aikami is free, open-source, and self-hosted. Clone the repo, spin up local AI, and start
        building your world. No waitlist. No subscription. Just code and creativity.
      </p>
    </div>

    <!-- Live telemetry tickers -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-12">
      <div class="glass-panel p-5 text-center">
        <p class="font-mono text-[10px] uppercase tracking-widest text-rune mb-1">
          Community Worlds
        </p>
        <p class="font-mono text-3xl tabnum text-foreground">
          <span id="stat-worlds" data-target="1247">0</span>
        </p>
        <p class="text-[10px] text-muted-foreground mt-1">Active self-hosted instances</p>
      </div>
      <div class="glass-panel p-5 text-center">
        <p class="font-mono text-[10px] uppercase tracking-widest text-ember mb-1">
          Quests Generated
        </p>
        <p class="font-mono text-3xl tabnum text-foreground">
          <span id="stat-quests" data-target="8932">0</span>
        </p>
        <p class="text-[10px] text-muted-foreground mt-1">AI-driven quests created today</p>
      </div>
      <div class="glass-panel p-5 text-center">
        <p class="font-mono text-[10px] uppercase tracking-widest text-rune mb-1">Contributors</p>
        <p class="font-mono text-3xl tabnum text-foreground">
          <span id="stat-npcs" data-target="284">0</span>
        </p>
        <p class="text-[10px] text-muted-foreground mt-1">Open source contributors</p>
      </div>
    </div>

    <!-- Primary CTAs -->
    <div class="flex flex-wrap justify-center gap-4 mb-10">
      <a
        href="https://github.com/BearlySleeping/aikami"
        class="group inline-flex items-center gap-3 rounded-sm bg-rune px-6 py-3.5 text-sm font-medium text-white transition-all hover:gap-4 no-underline shadow-rune hover:shadow-none"
      >
        <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
          />
        </svg>
        Star on GitHub
        <span id="github-stars" class="ml-1 rounded-sm bg-white/15 px-2 py-0.5 text-xs tabnum"
          >★ --</span
        >
      </a>
      <a
        href="https://github.com/BearlySleeping/aikami#quick-start"
        class="inline-flex items-center gap-3 rounded-sm border border-rune px-6 py-3.5 text-sm font-medium text-rune transition-all hover:bg-rune/10 no-underline"
      >
        Quickstart Guide &rarr;
      </a>
      <a
        href="https://discord.gg/aikami"
        class="inline-flex items-center gap-2 rounded-sm border border-border px-6 py-3.5 text-sm font-medium text-foreground transition-all hover:bg-card no-underline"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"
          />
        </svg>
        Join Discord
      </a>
    </div>

    <!-- Terminal one-liner card -->
    <div class="max-w-xl mx-auto">
      <div class="rune-border p-6 bg-card/80 backdrop-blur">
        <p class="font-mono text-[10px] uppercase tracking-widest text-muted-foreground mb-3">
          Get started in seconds
        </p>
        <div class="relative">
          <pre
            id="terminal-snippet"
            class="overflow-x-auto rounded-sm bg-background border border-border p-4 text-xs md:text-sm font-mono text-foreground leading-relaxed"
          ><code>git clone https://github.com/bearlysleeping/aikami.git && cd aikami && bun install && bun dev</code></pre>
          <button
            id="copy-snippet"
            type="button"
            class="absolute top-2 right-2 rounded-sm bg-card border border-border px-2.5 py-1 text-[10px] font-mono text-muted-foreground hover:text-foreground hover:border-rune transition-colors"
            aria-label="Copy terminal command to clipboard"
          >
            Copy
          </button>
        </div>
        <p class="mt-3 text-[10px] text-muted-foreground/60 text-center">
          Requires Bun runtime. Local AI models downloaded automatically on first run.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
// Animated stat counters
const animateCounter = (el: HTMLElement, target: number, duration = 2000) => {
  const start = 0;
  const startTime = performance.now();

  const step = (currentTime: number) => {
    const elapsed = currentTime - startTime;
    const progress = Math.min(elapsed / duration, 1);
    const eased = 1 - (1 - progress) ** 3;
    const current = Math.floor(start + (target - start) * eased);
    el.textContent = current.toLocaleString();

    if (progress < 1) {
      requestAnimationFrame(step);
    }
  };

  requestAnimationFrame(step);
};

// Animate on scroll into view
const observer = new IntersectionObserver(
  (entries) => {
    for (const entry of entries) {
      if (entry.isIntersecting) {
        const worldsEl = document.getElementById('stat-worlds');
        const questsEl = document.getElementById('stat-quests');
        const npcsEl = document.getElementById('stat-npcs');

        if (worldsEl) {
          animateCounter(worldsEl, Number.parseInt(worldsEl.dataset.target ?? '1247', 10));
        }
        if (questsEl) {
          animateCounter(questsEl, Number.parseInt(questsEl.dataset.target ?? '8932', 10));
        }
        if (npcsEl) {
          animateCounter(npcsEl, Number.parseInt(npcsEl.dataset.target ?? '284', 10));
        }

        observer.disconnect();
      }
    }
  },
  { threshold: 0.3 },
);

const guildSection = document.getElementById('adventurers-guild');
if (guildSection) {
  observer.observe(guildSection);
}

// GitHub star count — fetch live count
const starsEl = document.getElementById('github-stars');
if (starsEl) {
  fetch('https://api.github.com/repos/BearlySleeping/aikami')
    .then((res) => res.json())
    .then((data) => {
      const count = data.stargazers_count;
      if (typeof count === 'number') {
        starsEl.textContent = `★ ${count >= 1000 ? `${(count / 1000).toFixed(1)}k` : count}`;
      } else {
        starsEl.textContent = '★ 1.2k';
      }
    })
    .catch(() => {
      starsEl.textContent = '★ 1.2k';
    });
}

// Copy terminal snippet
const copyBtn = document.getElementById('copy-snippet');
const snippet = document.getElementById('terminal-snippet');

copyBtn?.addEventListener('click', () => {
  const text = snippet?.textContent?.trim() ?? '';
  navigator.clipboard
    .writeText(text)
    .then(() => {
      copyBtn.textContent = 'Copied!';
      setTimeout(() => {
        copyBtn.textContent = 'Copy';
      }, 2000);
    })
    .catch(() => {
      // Fallback
      copyBtn.textContent = 'Failed';
      setTimeout(() => {
        copyBtn.textContent = 'Copy';
      }, 2000);
    });
});
</script>
