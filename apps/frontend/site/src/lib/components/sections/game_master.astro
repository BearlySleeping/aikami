---
// apps/frontend/site/src/lib/components/sections/game_master.astro
/**
 * "A Game Master that runs the rules" — D&D 5e mechanics explained plainly,
 * with a browser of pre-generated sample NPCs as the centerpiece. These are
 * static examples on purpose: live inference per visitor would cost money,
 * and a "Generate" button that only ever returns canned data misrepresents
 * what the page is doing.
 */
import { webClientUrl } from '$data/site_content';
---

<section id="game-master" class="border-b border-border/70">
  <div class="mx-auto max-w-6xl px-6 py-24 md:py-28">
    <div class="max-w-2xl">
      <span class="eyebrow text-ember">A Game Master that runs the rules</span>
      <h2 class="mt-5 font-serif text-4xl md:text-5xl leading-tight">
        A real D&amp;D Game Master, not a chatbot with a dice emoji.
      </h2>
      <p class="mt-5 text-muted-foreground leading-relaxed">
        Every NPC in Aikami carries a real D&amp;D character sheet — ability scores, skills, and HP
        that the AI Game Master actually uses. An NPC with high Wisdom will see through your bluffs.
        One with low Charisma stumbles over their words. When you try to persuade a guard, the AI GM
        weighs your Charisma against their Wisdom, their mood, their faction, and what they remember
        about you — then calls for the roll.
      </p>
    </div>

    <div class="mt-10 max-w-2xl">
      <div class="grid grid-cols-3 gap-3">
        <div class="text-center p-3 rounded-sm bg-rune/5 border border-rune/10">
          <div class="font-mono text-[9px] uppercase tracking-wider text-rune mb-1">
            Ability Scores
          </div>
          <div class="text-xs text-muted-foreground">
            STR, DEX, CON, INT, WIS, CHA — assigned to every NPC and player
          </div>
        </div>
        <div class="text-center p-3 rounded-sm bg-ember/5 border border-ember/10">
          <div class="font-mono text-[9px] uppercase tracking-wider text-ember mb-1">Skills</div>
          <div class="text-xs text-muted-foreground">
            Proficiencies matched to archetype and backstory
          </div>
        </div>
        <div class="text-center p-3 rounded-sm bg-indigo-400/5 border border-indigo-400/10">
          <div class="font-mono text-[9px] uppercase tracking-wider text-indigo-400 mb-1">
            HP &amp; Combat
          </div>
          <div class="text-xs text-muted-foreground">
            Hit points, AC, and attacks derived from stats
          </div>
        </div>
      </div>

      <div class="glass-panel p-5 bg-rune/5 border-rune/30 mt-6">
        <p class="text-xs text-muted-foreground leading-relaxed">
          <span class="text-rune font-medium">The AI GM orchestrates everything.</span>
          You describe what your character does — no skill menus, no scripted combos. The Game
          Master decides if it's feasible, which check to roll, when a battle starts, and how the
          world answers back.
        </p>
      </div>
    </div>

    <!-- Sample NPC browser — real generated output, shipped as static examples.
         Deliberately NOT a live generator: running real inference per visitor
         would cost money and the fake "Generate" button it replaced implied
         something the page wasn't actually doing. -->
    <div class="mt-16" id="npc-examples">
      <div class="max-w-2xl mb-8">
        <span class="eyebrow text-rune">What the engine produces</span>
        <h3 class="mt-4 font-serif text-3xl md:text-4xl leading-tight">
          Every NPC arrives fully built.
        </h3>
        <p class="mt-4 text-muted-foreground leading-relaxed">
          These are real examples of what Aikami's NPC pipeline outputs — ability scores, skills, a
          lorebook entry, and opening dialogue, all generated together from a single archetype. Pick
          one to inspect the character sheet the Game Master actually rolls against.
        </p>
      </div>

      <!-- Example picker -->
      <div class="rune-border p-6 bg-card/50 backdrop-blur">
        <span class="block font-mono text-[10px] uppercase tracking-widest text-rune mb-3">
          Example NPCs
        </span>

        <!-- Preset chips -->
        <fieldset class="flex flex-wrap gap-2 mb-4 border-0 p-0" aria-label="NPC archetype presets">
          <button
            type="button"
            class="npc-chip rounded-full border border-rune/40 bg-rune/5 px-4 py-1.5 text-xs font-mono text-rune hover:bg-rune/15 transition-colors"
            data-prompt="Cynical Tavern Owner"
          >
            Cynical Tavern Owner
          </button>
          <button
            type="button"
            class="npc-chip rounded-full border border-ember/40 bg-ember/5 px-4 py-1.5 text-xs font-mono text-ember hover:bg-ember/15 transition-colors"
            data-prompt="Corrupt Mage"
          >
            Corrupt Mage
          </button>
          <button
            type="button"
            class="npc-chip rounded-full border border-indigo-400/40 bg-indigo-400/5 px-4 py-1.5 text-xs font-mono text-indigo-400 hover:bg-indigo-400/15 transition-colors"
            data-prompt="Rogue Mercenary"
          >
            Rogue Mercenary
          </button>
          <button
            type="button"
            class="npc-chip rounded-full border border-emerald-400/40 bg-emerald-400/5 px-4 py-1.5 text-xs font-mono text-emerald-400 hover:bg-emerald-400/15 transition-colors"
            data-prompt="Ancient Forest Spirit"
          >
            Ancient Forest Spirit
          </button>
          <button
            type="button"
            class="npc-chip rounded-full border border-rose-400/40 bg-rose-400/5 px-4 py-1.5 text-xs font-mono text-rose-400 hover:bg-rose-400/15 transition-colors"
            data-prompt="Disgraced Knight"
          >
            Disgraced Knight
          </button>
        </fieldset>

        <p class="text-[11px] text-muted-foreground/70 leading-relaxed">
          In the game, you don't pick from a list — the engine generates these from your world's
          context as you play.
          <a href={webClientUrl} class="text-rune hover:underline">Try it for real &rarr;</a>
        </p>
      </div>

      <!-- Live Preview Box -->
      <div
        id="npc-preview"
        class="mt-8 rune-border bg-card/50 backdrop-blur min-h-[320px] overflow-hidden"
      >
        <div id="npc-preview-content" class="p-8" aria-live="polite">
          <!-- Rendered by script -->
          <div class="flex flex-col items-center justify-center min-h-[280px] text-center">
            <div
              class="w-20 h-20 rounded-full border-2 border-rune/30 flex items-center justify-center mb-4"
            >
              <svg
                width="32"
                height="32"
                viewBox="0 0 24 24"
                fill="none"
                stroke="var(--rune)"
                stroke-width="1.5"
                aria-hidden="true"
              >
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                <circle cx="12" cy="7" r="4" />
              </svg>
            </div>
            <p class="text-muted-foreground/60 text-sm font-mono">
              Select an example above to view its character sheet.
            </p>
          </div>
        </div>
      </div>

      <!-- Small-print footnote: these are saved examples, not live output -->
      <p class="mt-3 text-[10px] leading-relaxed text-muted-foreground/50">
        Saved examples, served as static data — this page runs no AI. In the engine, every field
        here is generated at play time by whichever model you've configured, local or BYOK.
      </p>
    </div>
  </div>
</section>

<script>
/**
 * Pre-generated NPC database — simulates what the engine would produce.
 * In production, these would be generated by the AI pipeline.
 */
type NpcPreview = {
  name: string;
  archetype: string;
  appearance: string;
  stats: {
    str: number;
    dex: number;
    con: number;
    int: number;
    wis: number;
    cha: number;
    hp: number;
  };
  skills: string[];
  lorebook: string;
  dialogue: string;
  affinities: string[];
};

const npcDatabase: Record<string, NpcPreview> = {
  'cynical tavern owner': {
    name: 'Garrick Bramble',
    archetype: 'Cynical Tavern Owner',
    appearance:
      'Weathered human, mid-50s. Graying stubble, ale-stained apron, shrewd eyes that have seen too much.',
    stats: { str: 11, dex: 10, con: 13, int: 12, wis: 15, cha: 14, hp: 18 },
    skills: ['Insight +5', 'Persuasion +4', 'Brewing +6', 'Rumor Gathering +5'],
    lorebook:
      'Once a city guard captain, Garrick traded his badge for a bar after witnessing corruption too deep to fight. His tavern, The Bent Nail, is neutral ground for thieves and watchmen alike. He knows every rumor in a 50-mile radius — for the right price.',
    dialogue:
      '"Ale\'s three copper. Advice is free, but the good advice costs extra. What\'ll it be, stranger?"',
    affinities: ['Neutral Ground', 'Information Broker', 'Ex-Guard'],
  },
  'corrupt mage': {
    name: 'Velysia Thornwood',
    archetype: 'Corrupt Mage',
    appearance:
      'Elven woman, appears 30 (actual age unknown). Violet eyes glow faintly. Fingers stained with residual spell residue. Wears forbidden rune-tattoos on her forearms.',
    stats: { str: 8, dex: 14, con: 10, int: 18, wis: 12, cha: 16, hp: 14 },
    skills: ['Arcana +7', 'Deception +6', 'Necromancy +7', 'Alchemy +5'],
    lorebook:
      'Expelled from the Arcane Circle for experimenting with forbidden blood-magic, Velysia now operates from the shadows. She trades in curses, hexes, and information extracted from the dead. The Circle wants her captured — she wants the Circle dismantled.',
    dialogue:
      "\"Power doesn't corrupt, darling. Power reveals. And I've seen what lies in the hearts of the 'righteous.' Now — what do you need cursed?\"",
    affinities: ['Outcast', 'Forbidden Magic', 'Information Merchant'],
  },
  'rogue mercenary': {
    name: 'Kael Redthorne',
    archetype: 'Rogue Mercenary',
    appearance:
      'Half-orc, early 30s. Scarred knuckles, leather armor patched from a hundred battles. Twin daggers always within reach. A surprisingly warm smile.',
    stats: { str: 16, dex: 17, con: 15, int: 10, wis: 11, cha: 12, hp: 28 },
    skills: ['Stealth +6', 'Acrobatics +6', 'Intimidation +4', 'Survival +3'],
    lorebook:
      'Kael left his war-band after refusing to slaughter civilians. Now he sells his blade to the highest bidder — but only takes jobs he can live with. His former commander has placed a bounty on his head. Kael sleeps with one eye open.',
    dialogue:
      "\"I don't work for free, and I don't work for cowards. But if your coin's good and your cause is just... I'm listening.\"",
    affinities: ['Mercenary', 'Moral Code', 'Wanted'],
  },
  'ancient forest spirit': {
    name: 'Thornveil',
    archetype: 'Ancient Forest Spirit',
    appearance:
      'A spectral form woven from vines, moss, and starlight. Eyes like deep forest pools. Antlers of living wood crowned with glowing blossoms.',
    stats: { str: 14, dex: 18, con: 16, int: 17, wis: 20, cha: 15, hp: 36 },
    skills: ['Nature +8', 'Medicine +7', 'Perception +8', 'Arcana +5'],
    lorebook:
      "Thornveil has watched over the Emerald Grove for three thousand years. It remembers the first seed planted in this soil. The encroaching Iron Legion logging camps threaten its domain — and the ancient spirit's patience is wearing thin.",
    dialogue:
      '"Little flame-bearer... your kind burns so brightly, yet so briefly. What brings you to my grove, where time flows like honey?"',
    affinities: ['Ancient Guardian', 'Nature Domain', 'Threatened'],
  },
  'disgraced knight': {
    name: 'Ser Aldric Vale',
    archetype: 'Disgraced Knight',
    appearance:
      "Human, late 30s. Once-pristine armor now dented and tarnished. Still carries his order's shield — the emblem deliberately scratched out.",
    stats: { str: 17, dex: 12, con: 16, int: 10, wis: 13, cha: 11, hp: 32 },
    skills: ['Athletics +6', 'History +4', 'Intimidation +5', 'Animal Handling +4'],
    lorebook:
      "Ser Aldric was Captain of the Silver Guard until he defied orders to burn a village suspected of harboring necromancers. The village was innocent. His defiance cost him his rank, his title, and his family's honor. Now he wanders, seeking redemption — or a worthy death.",
    dialogue:
      '"I wear no lord\'s colors anymore. But if there are innocents in danger, my sword is yours. I won\'t fail again."',
    affinities: ['Exiled', 'Redemption Seeker', 'Protector'],
  },
};

// Stats abbreviations
const STAT_LABELS: Record<string, string> = {
  str: 'STR',
  dex: 'DEX',
  con: 'CON',
  int: 'INT',
  wis: 'WIS',
  cha: 'CHA',
};

const getStatMod = (value: number): string => {
  const mod = Math.floor((value - 10) / 2);
  return mod >= 0 ? `+${mod}` : `${mod}`;
};

const getStatColor = (value: number): string => {
  if (value >= 16) {
    return '#22c55e';
  }
  if (value >= 12) {
    return '#a78bfa';
  }
  if (value >= 8) {
    return '#c4b5fd';
  }
  return '#ef4444';
};

const escapeHtml = (unsafe: string): string => {
  return unsafe
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
};

const renderNpcPreview = (npc: NpcPreview) => {
  const preview = document.getElementById('npc-preview-content');
  if (!preview) {
    return;
  }

  // Provide screen reader announcement
  const srStatus = document.createElement('div');
  srStatus.className = 'sr-only';
  srStatus.textContent = `Loaded character sheet for ${npc.name}, ${npc.archetype}`;
  preview.appendChild(srStatus);
  setTimeout(() => srStatus.remove(), 1000);

  preview.innerHTML = `
    <div class="grid md:grid-cols-2 gap-8">
      <!-- Left: Portrait + Stats -->
      <div>
        <div class="flex items-start gap-5 mb-6">
          <!-- Generated Portrait placeholder -->
          <div class="w-24 h-24 rounded-full border-2 border-rune/50 bg-rune/5 flex items-center justify-center shrink-0">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--rune)" stroke-width="1.2" aria-hidden="true">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
          </div>
          <div>
            <h3 class="font-serif text-2xl leading-tight text-foreground">${escapeHtml(npc.name)}</h3>
            <p class="text-sm text-rune font-mono mt-0.5">${escapeHtml(npc.archetype)}</p>
            <p class="text-xs text-muted-foreground mt-2 leading-relaxed">${escapeHtml(npc.appearance)}</p>
          </div>
        </div>

        <!-- D&D Character Sheet Mini -->
        <div class="glass-panel p-5">
          <h4 class="font-mono text-[10px] uppercase tracking-widest text-muted-foreground mb-4">
            Character Sheet
          </h4>
          <div class="grid grid-cols-6 gap-3">
            ${Object.entries(npc.stats)
              .filter(([k]) => k !== 'hp')
              .map(
                ([key, value]) => `
              <div class="text-center">
                <div class="text-[10px] font-mono uppercase tracking-wider text-muted-foreground mb-1">${STAT_LABELS[key] ?? key.toUpperCase()}</div>
                <div class="text-lg font-mono tabnum font-bold" style="color: ${getStatColor(value as number)}">${value}</div>
                <div class="text-[10px] font-mono text-muted-foreground/60">${getStatMod(value as number)}</div>
              </div>
            `,
              )
              .join('')}
          </div>
          <div class="mt-4 pt-4 border-t border-border/50">
            <div class="flex items-center justify-between">
              <span class="font-mono text-[10px] uppercase tracking-wider text-rose-400">HP</span>
              <span class="font-mono text-lg tabnum text-rose-400 font-bold">${npc.stats.hp}</span>
            </div>
          </div>
          <div class="mt-3 flex flex-wrap gap-2">
            ${npc.skills
              .map(
                (s) => `
              <span class="rounded-sm bg-rune/10 border border-rune/20 px-2 py-0.5 text-[10px] font-mono text-rune">${escapeHtml(s)}</span>
            `,
              )
              .join('')}
          </div>
        </div>

        <!-- Affinity tags -->
        <div class="mt-4 flex flex-wrap gap-1.5">
          ${npc.affinities
            .map(
              (a) => `
            <span class="rounded-full bg-ember/5 border border-ember/20 px-2.5 py-0.5 text-[10px] font-mono text-ember/80">${escapeHtml(a)}</span>
          `,
            )
            .join('')}
        </div>
      </div>

      <!-- Right: Lorebook + Dialogue -->
      <div class="flex flex-col gap-5">
        <div class="glass-panel p-5 flex-1">
          <h4 class="font-mono text-[10px] uppercase tracking-widest text-muted-foreground mb-3">
            Auto-Generated Lorebook Snippet
          </h4>
          <p class="text-sm text-muted-foreground leading-relaxed">${escapeHtml(npc.lorebook)}</p>
        </div>

        <div class="glass-panel p-5 bg-ember/5 border-ember/30">
          <h4 class="font-mono text-[10px] uppercase tracking-widest text-ember mb-3">
            Sample Opening Dialogue
          </h4>
          <p class="text-sm text-foreground leading-relaxed italic font-serif">${escapeHtml(npc.dialogue)}</p>
        </div>
      </div>
    </div>
  `;

  // Animate the preview in
  preview.style.opacity = '0';
  preview.style.transform = 'translateY(8px)';
  preview.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
  requestAnimationFrame(() => {
    preview.style.opacity = '1';
    preview.style.transform = 'translateY(0)';
  });
};

// Chip clicks — each chip maps to one saved example, shown immediately.
const chips = document.querySelectorAll<HTMLElement>('.npc-chip');
for (const chip of chips) {
  chip.addEventListener('click', () => {
    const key = (chip.dataset.prompt ?? '').toLowerCase().trim();
    const npc = npcDatabase[key];
    if (npc) {
      renderNpcPreview(npc);
    }
  });
}
</script>

<style>
#npc-preview-content {
  opacity: 1;
  transform: translateY(0);
}
</style>
