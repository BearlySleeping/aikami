---
// apps/frontend/site/src/lib/components/sections/hero.astro
import { webClientUrl } from '$data/site_content';
---

<section class="hero border-b border-border/70">
  <div class="mx-auto max-w-6xl px-6 pb-12 pt-16 text-center md:pb-16 md:pt-24">
    <p
      class="inline-flex items-center gap-3 rounded-full border border-border bg-card px-4 py-2 text-xs text-muted-foreground sm:text-sm"
    >
      <span class="h-1.5 w-1.5 rounded-full bg-brand" aria-hidden="true"></span>
      Open-source RPG · Early development
    </p>
    <h1
      class="mx-auto mt-7 max-w-4xl text-[clamp(3rem,7.6vw,6.5rem)] leading-[1.02] tracking-tight"
    >
      Your next adventure<span class="block"
        >is yours to <em class="text-brand dark:text-brand-soft">shape.</em></span
      >
    </h1>
    <p class="mx-auto mt-6 max-w-xl text-base leading-relaxed text-muted-foreground md:text-lg">
      An open-source, AI-powered 2D RPG. Shape your campaign, explore its world, and meet people
      with stories of their own.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-3">
      <a
        href="#download"
        class="inline-flex min-h-12 items-center justify-center gap-3 rounded-sm bg-brand px-6 py-3 font-medium text-brand-foreground no-underline hover:opacity-90"
      >
        Download for desktop <span aria-hidden="true">↓</span>
      </a>
      <a
        href={webClientUrl}
        class="inline-flex min-h-12 items-center gap-2 text-sm text-foreground underline decoration-border underline-offset-8 hover:decoration-brand"
      >
        Play in your browser <span aria-hidden="true">↗</span>
      </a>
    </div>
    <p class="mx-auto mt-4 max-w-md text-sm leading-relaxed text-muted-foreground">
      Windows · macOS · Linux<br>
      Text AI required: connect a local model or your own cloud provider.
    </p>
    <div
      class="mx-auto mt-12 flex max-w-2xl flex-wrap items-center justify-center gap-x-8 gap-y-3 border-t border-border pt-6 text-sm text-muted-foreground"
    >
      <span>Open source</span>
      <span>Device-local saves</span>
      <span>Your choice of AI</span>
    </div>
  </div>
</section>

<style>
.hero {
  background: radial-gradient(
    ellipse at 50% 15%,
    color-mix(in oklch, var(--brand) 7%, transparent),
    transparent 65%
  );
}
</style>
