---
// apps/frontend/site/src/lib/components/sections/hero.astro
import { discordInviteLink, webClientUrl } from '$data/site_content';
---

<!-- Semantic DOM layer -->
<section class="relative overflow-hidden border-b border-border/70 min-h-[90dvh] flex items-center">
  <div class="grain absolute inset-0 opacity-60 z-[1] pointer-events-none" aria-hidden="true"></div>

  <!-- Ambient connecting-nodes canvas — confined to the hero, never intercepts clicks -->
  <canvas
    id="hero-nodes-canvas"
    class="absolute inset-0 z-0 pointer-events-none opacity-40"
    role="img"
    aria-label="Ambient animation of memory nodes connecting — steal from a merchant and they remember"
  ></canvas>

  <!-- Canvas layer — ambient PixiJS D20 + particles -->
  <div
    id="hero-canvas"
    class="absolute inset-0 z-0"
    role="img"
    aria-label="Interactive 3D d20 die with magical particle effects — click to roll"
  ></div>

  <div class="mx-auto max-w-6xl px-6 pt-16 pb-20 md:pt-24 md:pb-24 relative w-full z-10">
    <!-- Rune accent bar -->
    <div class="flex items-center gap-3 mb-8">
      <span class="h-px w-10 bg-rune" aria-hidden="true"></span>
      <span class="eyebrow text-rune">Open-Source AI RPG Engine</span>
    </div>

    <div class="grid lg:grid-cols-2 gap-12 lg:gap-6 items-start">
      <!-- Left column: Title + CTAs -->
      <div>
        <h1
          class="font-serif text-5xl leading-[1.02] tracking-tight md:text-7xl lg:text-[5rem] max-w-2xl"
        >
          Every NPC<br>
          <span class="text-rune">remembers what</span><br>
          <span class="italic text-muted-foreground">you did.</span>
        </h1>
        <p class="mt-8 max-w-xl text-lg leading-relaxed text-muted-foreground md:text-xl">
          Aikami is an AI-driven RPG engine with a real D&amp;D Game Master — no pre-written
          scripts. Steal from a merchant and they remember. Run your own copy on your own hardware,
          bring your own API keys, and never pay a subscription.
        </p>

        <!-- CTA hierarchy: one primary button, secondary text links below -->
        <div class="mt-10 flex flex-col items-start gap-4">
          <a
            href={webClientUrl}
            class="group inline-flex items-center gap-3 rounded-sm bg-rune px-7 py-4 text-base font-medium text-white transition-all hover:gap-4 no-underline shadow-rune hover:shadow-rune-hover"
          >
            Play now, free in your browser
            <span aria-hidden="true">&rarr;</span>
          </a>
          <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
            <a
              href="https://github.com/BearlySleeping/aikami"
              class="inline-flex items-center gap-2 text-muted-foreground hover:text-rune transition-colors no-underline"
            >
              <svg
                width="14"
                height="14"
                viewBox="0 0 16 16"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
                />
              </svg>
              Self-Host on GitHub
            </a>
            <a
              href={discordInviteLink}
              class="inline-flex items-center gap-2 text-muted-foreground hover:text-ember transition-colors no-underline"
            >
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"
                />
              </svg>
              Join Discord
            </a>
          </div>
        </div>

        <!-- Pill Badges -->
        <div
          class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-[11px] uppercase tracking-wider text-muted-foreground"
        >
          <span
            class="inline-flex items-center gap-2 rounded-full border border-rune/30 bg-rune/5 px-3 py-1"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-rune" aria-hidden="true"></span>
            NPCs Remember
          </span>
          <span
            class="inline-flex items-center gap-2 rounded-full border border-ember/30 bg-ember/5 px-3 py-1"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-ember" aria-hidden="true"></span>
            Real D&amp;D Game Master
          </span>
          <span
            class="inline-flex items-center gap-2 rounded-full border border-rune/30 bg-rune/5 px-3 py-1"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-rune" aria-hidden="true"></span>
            Self-Hosted
          </span>
          <span
            class="inline-flex items-center gap-2 rounded-full border border-emerald-400/30 bg-emerald-400/5 px-3 py-1"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400" aria-hidden="true"></span>
            Bring Your Own API Key
          </span>
          <span
            class="inline-flex items-center gap-2 rounded-full border border-indigo-400/30 bg-indigo-400/5 px-3 py-1"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-indigo-400" aria-hidden="true"></span>
            No Subscription
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
/** Defer PixiJS init to avoid blocking LCP — load after idle callback or short delay. */
const containerId = 'hero-canvas';
let cleanup: (() => void) | undefined;
let idleHandle: number | undefined;
let timeoutHandle: ReturnType<typeof setTimeout> | undefined;
let disposed = false;

const initWhenReady = () => {
  if (disposed) {
    return;
  }
  import('./hero_d20')
    .then(async ({ initHeroD20 }) => {
      if (disposed) {
        return;
      }
      const cleanupFn = await initHeroD20(containerId);
      if (disposed) {
        cleanupFn();
      } else {
        cleanup = cleanupFn;
      }
    })
    .catch(() => {
      // Canvas initialization failed — no fallback needed
    });
};

if ('requestIdleCallback' in globalThis) {
  idleHandle = requestIdleCallback(initWhenReady, { timeout: 2000 });
} else {
  timeoutHandle = setTimeout(initWhenReady, 200);
}

document.addEventListener('astro:before-swap', () => {
  disposed = true;
  if (idleHandle !== undefined) {
    cancelIdleCallback(idleHandle);
  }
  if (timeoutHandle !== undefined) {
    clearTimeout(timeoutHandle);
  }
  cleanup?.();
});
</script>

<script>
/**
 * Ambient connecting-nodes animation (memory-graph motif) behind the hero.
 * Pure canvas, no dependencies — low opacity so it never competes with text.
 * Disabled entirely under prefers-reduced-motion.
 */
(() => {
  const canvas = document.getElementById('hero-nodes-canvas') as HTMLCanvasElement | null;
  if (!canvas) {
    return;
  }
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    canvas.remove();
    return;
  }

  const ctx = canvas.getContext('2d');
  if (!ctx) {
    canvas.remove();
    return;
  }

  let width = 0;
  let height = 0;
  let raf = 0;

  const NodeCount = 26;
  type Node = { x: number; y: number; vx: number; vy: number; r: number; phase: number };
  let nodes: Node[] = [];

  const resize = () => {
    const rect = canvas.parentElement?.getBoundingClientRect();
    width = canvas.width = Math.floor(rect?.width ?? window.innerWidth);
    height = canvas.height = Math.floor(rect?.height ?? window.innerHeight);
  };

  const seed = () => {
    nodes = Array.from({ length: NodeCount }, () => ({
      x: Math.random() * width,
      y: Math.random() * height,
      vx: (Math.random() - 0.5) * 0.4,
      vy: (Math.random() - 0.5) * 0.4,
      r: 1.2 + Math.random() * 2.2,
      phase: Math.random() * Math.PI * 2,
    }));
  };

  const step = (t: number) => {
    ctx.clearRect(0, 0, width, height);
    const css = getComputedStyle(document.documentElement);
    const line = css.getPropertyValue('--rune').trim() || 'oklch(0.65 0.22 285)';

    // Edges between nearby nodes
    for (let i = 0; i < nodes.length; i += 1) {
      const a = nodes[i];
      if (!a) {
        continue;
      }
      for (let j = i + 1; j < nodes.length; j += 1) {
        const b = nodes[j];
        if (!b) {
          continue;
        }
        const dx = a.x - b.x;
        const dy = a.y - b.y;
        const dist = Math.hypot(dx, dy);
        if (dist < 130) {
          ctx.strokeStyle = line;
          ctx.globalAlpha = (1 - dist / 130) * 0.16;
          ctx.lineWidth = 0.7;
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(b.x, b.y);
          ctx.stroke();
        }
      }
    }

    // Nodes drift + pulse
    ctx.globalAlpha = 1;
    for (const n of nodes) {
      n.x += n.vx;
      n.y += n.vy;
      if (n.x < -20) {
        n.x = width + 20;
      }
      if (n.x > width + 20) {
        n.x = -20;
      }
      if (n.y < -20) {
        n.y = height + 20;
      }
      if (n.y > height + 20) {
        n.y = -20;
      }
      const pulse = 0.35 + 0.3 * Math.sin(t / 900 + n.phase);
      ctx.globalAlpha = pulse;
      ctx.fillStyle = line;
      ctx.beginPath();
      ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.globalAlpha = 1;
    raf = requestAnimationFrame(step);
  };

  const start = () => {
    resize();
    seed();
    raf = requestAnimationFrame(step);
  };

  let resizeTimer: ReturnType<typeof setTimeout> | undefined;
  const onResize = () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      resize();
      seed();
    }, 150);
  };

  window.addEventListener('resize', onResize);
  document.addEventListener('astro:before-swap', () => {
    cancelAnimationFrame(raf);
    window.removeEventListener('resize', onResize);
  });

  start();
})();
</script>
