{
  "name": "@aikami/site",
  "license": "MIT",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "dev:emulator": "astro dev --mode emulator",
    "dev:staging": "astro dev --mode staging",
    "dev:production": "astro dev --mode production",
    "build": "astro build",
    "build:emulator": "astro build --mode emulator",
    "build:staging": "astro build --mode staging",
    "build:production": "astro build --mode production",
    "deploy": "bun run scripts/deploy.ts",
    "preview": "astro preview",
    "preview:chromium": "bun run scripts/launch_chromium.ts",
    "unlighthouse": "bun run build && bunx astro preview --port 4398 & sleep 3 && bunx unlighthouse-ci --site http://localhost:4398; kill %1 2>/dev/null || true",
    "lint": "biome check src/ scripts/ astro.config.ts",
    "fix": "biome check --write src/ scripts/ astro.config.ts --error-on-warnings",
    "format": "biome format src/ scripts/ astro.config.ts",
    "typecheck": "astro sync && astro check",
    "test": "true",
    "logs": "bun run ../../../scripts/ops/logs.ts site",
    "logs:tail": "bun run ../../../scripts/ops/logs.ts site --tail"
  },
  "dependencies": {
    "@aikami/constants": "workspace:*",
    "@aikami/schemas": "workspace:*",
    "@aikami/types": "workspace:*",
    "@aikami/frontend/theme": "workspace:*",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "pixi.js": "8.20.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/mdx": "7.0.8",
    "@astrojs/partytown": "2.1.7",
    "@astrojs/sitemap": "3.7.3",
    "@tailwindcss/vite": "4.3.3",
    "@unlighthouse/cli": "0.18.0",
    "astro": "7.2.7",
    "astro-compress": "2.4.3",
    "astro-robots-txt": "1.0.0",
    "lighthouse": "13.4.1",
    "tailwindcss": "4.3.3",
    "vite": "8.2.2",
    "wrangler": "4.126.0"
  }
}
