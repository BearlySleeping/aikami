# Public (exposed to client)
# Required: full site URL (e.g., http://localhost:4321 for dev, https://yourdomain.com for prod)
PUBLIC_SITE_URL=
PUBLIC_GA_ID=
PUBLIC_CLARITY_ID=

PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_MEASUREMENT_ID=

PUBLIC_RECAPTCHA_SITE_KEY=
PUBLIC_APP_CHECK_DEBUG_TOKEN=
PUBLIC_DISABLE_APP_CHECK=

PUBLIC_MODE=production
PUBLIC_LOG_PERSIST_LEVEL=
PUBLIC_APP_ID=site

# Download channels — Tauri desktop releases from GitHub Releases.
#  - stable: newest production (non-prerelease) release
#  - latest: newest release (may include prereleases)
# Staging never gets official releases — staging workflow runs only produce
# ephemeral workflow artifacts — so the site never links to staging.
PUBLIC_GITHUB_REPO=BearlySleeping/aikami
