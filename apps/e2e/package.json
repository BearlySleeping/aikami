{
  "name": "@aikami/e2e",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:client": "playwright test --project=client",
    "test:game": "playwright test --project=game",
    "test:visual": "bun run src/visual/runner.ts",
    "lpc:smoke": "bun run scripts/lpc_smoke.ts",
    "test:release-gate": "playwright test tests/client/release_gate.spec.ts --project=client",
    "test:release-gate:offline": "playwright test tests/client/release_gate.spec.ts --project=client-offline",
    "test:release-gate:keyboard": "playwright test tests/client/release_gate.spec.ts --project=client-keyboard",
    "test:ai-services": "playwright test --project=ai-services",
    "test:site": "playwright test --config=playwright.config.ts --project=site-chromium --project=site-mobile",
    "test:site:a11y": "playwright test --config=playwright.config.ts --project=site-chromium tests/site/site_accessibility",
    "test:site:visual": "playwright test --config=playwright.config.ts --project=site-chromium --project=site-mobile tests/site/visual_regression",
    "lint": "biome lint .",
    "format": "biome format .",
    "fix": "biome check --write . --error-on-warnings",
    "typecheck": "tsgo --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "playwright": "1.62.1"
  },
  "dependencies": {
    "@aikami/constants": "workspace:*",
    "@aikami/types": "workspace:*",
    "@axe-core/playwright": "4.13.0",
    "sharp": "0.35.3",
    "typebox": "1.3.18"
  }
}
