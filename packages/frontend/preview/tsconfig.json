{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    "strict": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "../..",
    "types": ["vite/client"],
    "paths": {
      "@aikami/frontend/engine/content": ["../../frontend/engine/src/assets/content_pack_loader.ts"],
      "@aikami/lpc": ["../../shared/lpc/src"],
      "@aikami/types": ["../../shared/types/src"]
    }
  },
  "include": ["src/**/*.d.ts", "src/**/*.ts", "src/**/*.js", "src/**/*.svelte"]
}
