  "npcs": {
    "village_elder": {
      "name": "Elder Thalia",
      "defaultDialogueKey": "elder_thalia_greeting",
      "appearanceLayers": [
        2,
        3,
        65,
        21,
        20,
        97
      ],
      "isVendor": false,
      "initialSuggestions": [
        {
          "id": "elder_ask_ward",
          "label": "🕯️ Ask about the ward",
          "intentType": "quest",
          "prefillText": "The ward is failing, you said — can you tell me what happened to it?"
        },
        {
          "id": "elder_offer_help",
          "label": "🤝 Offer to help",
          "intentType": "quest",
          "prefillText": "I would like to help Emberwatch — is there a task you need done?"
        },
        {
          "id": "elder_ask_wand",
          "label": "🪄 Ask about the Ward Wand",
          "intentType": "quest",
          "prefillText": "You mentioned the Ward Wand — what is it, and where can I find it?"
        }
      ]
    },
    "rollo_grasper": {
      "name": "Rollo the Grasper",
      "defaultDialogueKey": "rollo_greeting",
      "appearanceLayers": [
        3,
        123,
        23,
        22,
        7,
        95
      ],
      "isVendor": false,
      "combatStats": {
        "hitPoints": 20,
        "armorClass": 11,
        "attackBonus": 2,
        "damage": "1d4",
        "initiativeBonus": 0,
        "xpValue": 30
      },
      "initialSuggestions": [
        {
          "id": "rollo_ask_wand",
          "label": "🪄 Ask about the Ward Wand",
          "intentType": "quest",
          "prefillText": "I hear you hold the Ward Wand — the one Emberwatch needs."
        },
        {
          "id": "rollo_persuade",
          "label": "🗣️ Reason with him",
          "intentType": "skill_check",
          "prefillText": "Emberwatch needs that wand to survive — name your price, please."
        },
        {
          "id": "rollo_intimidate",
          "label": "😡 Intimidate him",
          "intentType": "skill_check",
          "prefillText": "Hand over the wand now, or I will take it from you by force."
        },
        {
          "id": "rollo_leave",
          "label": "🚶 Turn back",
          "intentType": "dialogue",
          "prefillText": "Fine. Keep your trinket for now — but this is not over."
        }
      ]
    },
