#!/usr/bin/env bash
#
# 🔴 HAND-WRITTEN. Not generated by moon, and deliberately NOT declared in
# .moon/workspace.yml `vcs.hooks` — see the comment block there for the full
# reasoning. The short version:
#
# moon's generated hook template opens with `set -eo pipefail` and then runs
# the configured command verbatim. That is fatal for THIS hook specifically —
# a non-zero post-checkout makes `git checkout` ITSELF exit non-zero, so every
# `git checkout && …` chain and every execFileSync git call breaks. And since
# a package script resolves against whatever tree was just checked out,
# checking out any branch older than that script IS that failure — permanently,
# for every old branch, forever. The invocation below is instead anchored to
# this trusted hook's directory and names the sync entrypoint directly.
#
# So this hook is incapable of failing: no `set -e`, output swallowed,
# unconditional `exit 0`. A tree without the `sync-workspace` script, or a
# machine without bun, degrades to doing nothing — never to a broken checkout.
#
# Git for Windows runs `#!/usr/bin/env bash` hooks through its bundled sh, so
# no PowerShell variant is needed here.
#
# The linked-worktree guard lives inside the script (ops/sync_workspace.ts):
# `moon sync` must never run in a worktree, or its tsconfig/project-sync
# artifacts get swept into a contract-pipeline commit by `git add -A`.

# $3 is 1 for a branch checkout, 0 for a file checkout (`git checkout -- x`).
# Only a branch switch can change the project graph; skip the rest.
if [ "$3" != "1" ]; then
  exit 0
fi

hook_directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
bun run "$hook_directory/../../scripts/src/lib/ops/sync_workspace.ts" >/dev/null 2>&1
exit 0
