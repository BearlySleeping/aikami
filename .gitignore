# --- 8. Global Allow-List (Exceptions) ---
#
# This section MUST be at the end.
# It overrides general rules from above to
# allow specific, shared config files.
#
## ✅ VS Code Team Settings
# Ignore all of .vscode, *except* for these specific files
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/cspell.json


.moon/cache
**/script-config.production.ts
**/script-config.staging.ts

# .pi cache directories (per-project, generated)
.pi/*/.cache/
.pi/*/command_durations.json

# Runtime background-task logs (keep the README)
.pi/background-tasks/*
!.pi/background-tasks/README.md

script-config.*.ts
test-results/

*.gd.uid
examples
.direnv/
apps/frontend/client/src-tauri/target/
apps/frontend/client/src-tauri/gen/
scripts/lpc/.lpc_manifest.json

# LPC assets — canonical source is Firebase Storage
apps/backend/packages/
# Swarm artifacts — ephemeral pipeline outputs
.pi/swarm/agent_scratchpad.db*
.pi/swarm/markers/
.pi/swarm/outputs/

# Contract pipeline runs (new stable pipeline)
.pi/contract-runs/
# Infrastructure-issue log (scripts/src/lib/ops/infra_report.ts) — local
# triage data, not a project artifact.
.pi/infra-issues.jsonl
# JiJutsu co-located workspaces for contract pipeline isolation
.pi/workspaces/
.pi/swarm/plans/
.pi/swarm/payloads/
.pi/pipeline_payload_*.json
.pi/agent_scratchpad.db*
.pi/MARKER_*
.pi/architect_plan_*.md
**/**/.pi/cache
tmp/
.gcloud/
apps/frontend/client/static/game-assets/
.pi/github/
apps/backend/image/src/user/comfyui.db.bkp
.pi/autofix/system_prompt.md
apps/frontend/client/.fast-check/
firebase.deploy.json
Aikami-x86_64.AppImage
.secrets/
**/.fast-check/

# Pipeline verification evidence — verifier/implementer screenshots must live
# in the gitignored .pi/.screenshots/ (browser_screenshot tool) or
# apps/e2e/test-results/visual/ (visual runner). Any screenshot saved to the
# worktree root or an artifacts/ dir is a leak — never commit it. See
# .pi/prompts/contract-verify.md Phase 3 for the evidence-save rule.
artifacts/
/*.png
/*.jpg
/*.jpeg
/*.webp
/*.gif

# Drizzle D1 migration snapshots (generated, churn on every migration) — keep
# the migration SQL files (drizzle-d1/*.sql) committed as the schema source of
# truth, but ignore the meta/ snapshot JSON + journal.
packages/backend/database/drizzle-d1/meta/
